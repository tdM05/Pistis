import Mathlib
import Pistis
import items.item1.step1
import items.item1.step2
set_option linter.unusedTactic false

open Function Fintype Subgroup Ideal Polynomial Submodule Zsqrtd
open scoped BigOperators



/-Informal Statement

Let $H$ be the subgroup generated by two elements $a, b$ of a group $G$. Prove that if $a b=b a$, then $H$ is an abelian group.
-/

theorem Artin_exercise_2_2_9 {G : Type*} [Group G] {a b : G}
  (h : a * b = b * a) :
  ∀ x y : closure {x | x = a ∨ x = b}, x * y = y * x := by
  set H := closure {x | x = a ∨ x = b} with hH
  pistis_intro "1.0"
    r"Let $H$ be the subgroup generated by two elements $a, b$ of a group $G$. Prove that if $a b=b a$, then $H$ is an abelian group."

  -- @pistis_assumption ("$a$ and $b$ commute", a * b = b * a)
  pistis_segment "1.1"
    r"Since $a$ and $b$ commute, for any $g, h\in H$ we can write $g=a^ib^j$ and $h = a^kb^l$."
    (step1 : ∀ g h : H, ∃ i j k l : ℤ, (g : G) = a ^ i * b ^ j ∧ (h : G) = a ^ k * b ^ l) := by
      exact helper_Artin_exercise_2_2_9_step1
        (by pistis_assumption "$a$ and $b$ commute" (show a * b = b * a; assumption))

  -- @pistis_assumption ("", ∀ g h : H, ∃ i j k l : ℤ, (g : G) = a ^ i * b ^ j ∧ (h : G) = a ^ k * b)
  pistis_segment "1.2"
    r"Then $gh = a^ib^ja^kb^l = a^kb^la^ib^j = hg$."
    (step2 : ∀ g h : H, g * h = h * g) := by
      exact helper_Artin_exercise_2_2_9_step2 step1
        (by pistis_assumption "" (show a * b = b * a; assumption))

  pistis_conclude "1.3"
    r"Thus $H$ is abelian."

  exact step2
