import Mathlib
import Pistis

open Subgroup Set

namespace Item223

variable {G : Type*} [Group G]

/-- Core engine: in any group, `x^a` lies in the cyclic subgroup generated by `x^b`
iff `gcd(orderOf x, b)` divides `a` (as integers). -/
theorem mem_zpowers_pow_iff_gcd_dvd {x : G} (a b : ℕ) :
    x ^ a ∈ Subgroup.zpowers (x ^ b) ↔ (Nat.gcd (orderOf x) b : ℤ) ∣ (a : ℤ) := by
  rw [Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨j, hj⟩
    rw [← zpow_natCast x b, ← zpow_mul, ← zpow_natCast x a, zpow_eq_zpow_iff_modEq] at hj
    have hn : (orderOf x : ℤ) ∣ (↑b * j - ↑a) := (Int.ModEq.symm hj).dvd
    have hgb : (Nat.gcd (orderOf x) b : ℤ) ∣ (↑b * j - ↑a) :=
      dvd_trans (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_left _ b)) hn
    have hbb : (Nat.gcd (orderOf x) b : ℤ) ∣ (↑b * j) :=
      Dvd.dvd.mul_right (Int.natCast_dvd_natCast.mpr (Nat.gcd_dvd_right _ b)) j
    have : (Nat.gcd (orderOf x) b : ℤ) ∣ (↑b * j - (↑b * j - ↑a)) := dvd_sub hbb hgb
    simpa using this
  · intro hdvd
    obtain ⟨u, v, huv⟩ : ∃ u v : ℤ, (Nat.gcd (orderOf x) b : ℤ) = orderOf x * u + b * v := by
      refine ⟨Nat.gcdA (orderOf x) b, Nat.gcdB (orderOf x) b, ?_⟩
      have := Nat.gcd_eq_gcd_ab (orderOf x) b
      exact_mod_cast this
    obtain ⟨m, hm⟩ := hdvd
    refine ⟨v * m, ?_⟩
    rw [← zpow_natCast x b, ← zpow_mul, ← zpow_natCast x a, zpow_eq_zpow_iff_modEq]
    have ha : (a : ℤ) = ((orderOf x : ℤ) * u + b * v) * m := by rw [← huv, hm]
    rw [Int.modEq_iff_dvd]
    exact ⟨u * m, by rw [ha]; ring⟩

/-- `gcd(orderOf x, b) ∣ a` as naturals is the same characterization. -/
theorem mem_zpowers_pow_iff_gcd_dvd_nat {x : G} (a b : ℕ) :
    x ^ a ∈ Subgroup.zpowers (x ^ b) ↔ Nat.gcd (orderOf x) b ∣ a := by
  rw [mem_zpowers_pow_iff_gcd_dvd, Int.natCast_dvd_natCast]

/-- `closure {g} = zpowers g`. -/
theorem closure_singleton_eq_zpowers (g : G) :
    Subgroup.closure {g} = Subgroup.zpowers g := (zpowers_eq_closure g).symm

/-- Membership in `closure {x^b}` via gcd. -/
theorem mem_closure_pow_iff_gcd_dvd {x : G} (a b : ℕ) :
    x ^ a ∈ Subgroup.closure {x ^ b} ↔ Nat.gcd (orderOf x) b ∣ a := by
  rw [closure_singleton_eq_zpowers, mem_zpowers_pow_iff_gcd_dvd_nat]

/-- `closure {x^a} ≤ closure {x^b}` iff `x^a ∈ closure {x^b}`. -/
theorem closure_pow_le_iff_mem {x : G} (a b : ℕ) :
    Subgroup.closure {x ^ a} ≤ Subgroup.closure {x ^ b} ↔ x ^ a ∈ Subgroup.closure {x ^ b} := by
  rw [Subgroup.closure_le]; simp [Set.singleton_subset_iff]

/-- Inclusion of cyclic subgroups via gcd divisibility. -/
theorem closure_pow_le_iff_gcd_dvd {x : G} (a b : ℕ) :
    Subgroup.closure {x ^ a} ≤ Subgroup.closure {x ^ b} ↔ Nat.gcd (orderOf x) b ∣ Nat.gcd (orderOf x) a := by
  rw [closure_pow_le_iff_mem, mem_closure_pow_iff_gcd_dvd]
  constructor
  · intro h; exact Nat.dvd_gcd (Nat.gcd_dvd_left _ _) h
  · intro h; exact dvd_trans h (Nat.gcd_dvd_right _ _)

/-- A cyclic subgroup `closure {x^a}` is all of `G` iff `gcd(orderOf x, a) = 1`
(using that `x` generates `G`). -/
theorem closure_pow_eq_top_iff_gcd {x : G} (a : ℕ) (htop : Subgroup.closure ({x} : Set G) = ⊤) :
    Subgroup.closure {x ^ a} = ⊤ ↔ Nat.gcd (orderOf x) a = 1 := by
  rw [eq_top_iff, ← htop, Subgroup.closure_le]
  simp only [Set.singleton_subset_iff, SetLike.mem_coe]
  have hx1 : x ∈ Subgroup.closure {x ^ a} ↔ Nat.gcd (orderOf x) a ∣ 1 := by
    have := mem_closure_pow_iff_gcd_dvd (x := x) 1 a
    rwa [pow_one] at this
  rw [hx1]
  exact ⟨fun h => Nat.eq_one_of_dvd_one h, fun h => by rw [h]⟩

/-- Two cyclic subgroups coincide iff their gcds with `orderOf x` are equal. -/
theorem closure_pow_eq_iff_gcd {x : G} (a b : ℕ) :
    Subgroup.closure {x ^ a} = Subgroup.closure {x ^ b} ↔
      Nat.gcd (orderOf x) a = Nat.gcd (orderOf x) b := by
  rw [le_antisymm_iff, closure_pow_le_iff_gcd_dvd, closure_pow_le_iff_gcd_dvd]
  exact ⟨fun ⟨h1, h2⟩ => Nat.dvd_antisymm h2 h1, fun h => by rw [h]; exact ⟨dvd_refl _, dvd_refl _⟩⟩

/-- `closure {x^a} = closure {x^(gcd(orderOf x, a))}`: every cyclic subgroup is generated by a
divisor of `orderOf x`. -/
theorem closure_pow_eq_closure_pow_gcd {x : G} (a : ℕ) :
    Subgroup.closure {x ^ a} = Subgroup.closure {x ^ (Nat.gcd (orderOf x) a)} := by
  rw [closure_pow_eq_iff_gcd]
  exact (Nat.gcd_eq_right (Nat.gcd_dvd_left _ _)).symm

/-- If `G` is generated by `x` with `orderOf x = n > 0`, then `G` is finite. -/
theorem finite_of_generator {n : ℕ} {x : G} (hx : orderOf x = n) (hn : 0 < n)
    (hG : Subgroup.closure ({x} : Set G) = ⊤) : Finite G := by
  have htop : Subgroup.zpowers x = ⊤ := by
    rw [← closure_singleton_eq_zpowers, hG]
  have hfin : 0 < orderOf x := by rw [hx]; exact hn
  have : Finite (Subgroup.zpowers x) :=
    Nat.finite_of_card_ne_zero (by rw [Nat.card_zpowers]; omega)
  rw [htop] at this
  exact Finite.of_equiv _ Subgroup.topEquiv.toEquiv

end Item223
