import Mathlib

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators



/-Informal Statement

Prove that if $H$ is a normal subgroup of $G$ of prime index $p$ then for all $K \leq G$ either $K \leq H$, or $G=H K$ and $|K: K \cap H|=p$.
-/

/-Informal Proof

Solution: Suppose $K \backslash N \neq \emptyset$; say $k \in K \backslash N$. Now $G / N \cong \mathbb{Z} /(p)$ is cyclic, and moreover is generated by any nonidentity- in particular by $\bar{k}$

Now $K N \leq G$ since $N$ is normal. Let $g \in G$. We have $g N=k^a N$ for some integer a. In particular, $g=k^a n$ for some $n \in N$, hence $g \in K N$. We have $[K: K \cap N]=p$ by the Second Isomorphism Theorem.
-/

theorem Dummit_Foote_exercise_3_3_3 {p : Nat.Primes} {G : Type*} [Group G]
  {H : Subgroup G} [hH : H.Normal] (hH1 : H.index = p) :
  ∀ K : Subgroup G, K ≤ H ∨ (H ⊔ K = ⊤ ∧ (K ⊓ H).relIndex K = p) := by
  classical
  -- Step 1: Allow classical logic so that we can freely reason by cases and contradiction.
  intro K
  -- Step 2: Fix an arbitrary subgroup `K` and perform a case split based on `K ≤ H`.
  by_cases hK : K ≤ H
  · -- Step 3.1: When `K ≤ H`, the desired disjunction is satisfied immediately.
    exact Or.inl hK
  · -- Step 3.2: Assume `K` is not contained in `H` and work toward the second disjunct.
    have hrel_dvd :
        H.relIndex (H ⊔ K) ∣ p := by
      -- Step 4: The relative index divides `H.index = p` because `H ≤ H ⊔ K`.
      simpa [hH1] using
        (Subgroup.relIndex_dvd_index_of_le (H:=H) (K:=H ⊔ K) le_sup_left)
    have hrel_ne_one :
        H.relIndex (H ⊔ K) ≠ 1 := by
      -- Step 5: If the relative index were 1, `H ⊔ K` would lie inside `H`, forcing `K ≤ H`.
      intro hrel
      have hsup_le : H ⊔ K ≤ H :=
        (Subgroup.relIndex_eq_one (H:=H) (K:=H ⊔ K)).1 hrel
      have : K ≤ H := le_trans le_sup_right hsup_le
      exact hK this
    have hrel_eq_p : H.relIndex (H ⊔ K) = p := by
      -- Step 6: The prime nature of `p` leaves only the options `1` or `p` for the divisor.
      rcases
          p.2.eq_one_or_self_of_dvd (H.relIndex (H ⊔ K)) hrel_dvd with
        hcase | hcase
      · exact (hrel_ne_one hcase).elim
      · exact hcase
    have hindex_eq_one : (H ⊔ K).index = 1 := by
      -- Step 7: Use `H.relIndex (H ⊔ K) * (H ⊔ K).index = p` and cancel the nonzero factor `p`.
      have hmul :=
        Subgroup.relIndex_mul_index (H:=H) (K:=H ⊔ K) le_sup_left
      have hmul' : H.relIndex (H ⊔ K) * (H ⊔ K).index = p := by
        simpa [hH1] using hmul
      have hmul'' : (p : ℕ) * (H ⊔ K).index = p := by
        simpa [hrel_eq_p] using hmul'
      have hp_pos : 0 < (p : ℕ) := p.2.pos
      have hcanon : (p : ℕ) * (H ⊔ K).index = (p : ℕ) * 1 := by
        simpa using hmul''
      exact Nat.mul_left_cancel hp_pos hcanon
    have hsup_top : H ⊔ K = (⊤ : Subgroup G) := by
      -- Step 8: Index one characterizes the top subgroup.
      simpa using (Subgroup.index_eq_one (H:=H ⊔ K)).1 hindex_eq_one
    have hreleq :
        H.relIndex (H ⊔ K) = H.relIndex K := by
      -- Step 9.1: Normality of `H` allows us to replace `(H ⊔ K)` with `K` in the relative index.
      exact (Subgroup.relIndex_sup_left (H:=K) (K:=H))
    have hrelindexHK : H.relIndex K = p :=
      hreleq.symm.trans hrel_eq_p
    have hinfEq :
        (K ⊓ H).relIndex K = H.relIndex K := by
      -- Step 9.2: Intersecting with `H` inside `K` recovers the same relative index.
      simpa [inf_comm] using (Subgroup.inf_relIndex_right (H:=H) (K:=K))
    have hrelindex_inf : (K ⊓ H).relIndex K = p :=
      hinfEq.trans hrelindexHK
    -- Step 10: Conclude that the second disjunct holds with the computed equalities.
    refine Or.inr ?_
    refine ⟨hsup_top, ?_⟩
    -- Step 10.1: Rewrite the goal using the new spelling and apply the computed equality.
    change (K ⊓ H).relIndex K = p
    exact hrelindex_inf
