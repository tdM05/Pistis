import Mathlib

open Fintype Set Real Ideal Polynomial Subgroup
open scoped BigOperators



/-Informal Statement

If a group $G$ has no proper subgroups, prove that $G$ is cyclic of order $p$, where $p$ is a prime number.
-/

/-Informal Proof

Case-1: $G=(e), e$ being the identity element in $G$. Then trivially $G$ is cyclic.
    Case-2: $G \neq(e)$. Then there exists an non-identity element in $G.$ Let us consider an non-identity element in $G$, say $a\neq (e)$. Now look at the cyclic subgroup generated by $a$, that is, $\langle a\rangle$. Since
    $a\neq (e) \in G,\langle a\rangle$ is a subgroup of $G$.
If $G \neq\langle a\rangle$ then $\langle a\rangle$ is a proper non-trivial subgroup of $G$, which is an impossibility. Therefore we must have
$$
G=\langle a\rangle .
$$
This implies, $G$ is a cyclic group generated by $a$. Then it follows that every non-identity element of $G$ is a generator of $G$. Now we claim that $G$ is finite.
-/

theorem Herstein_exercise_2_3_16 {G : Type*} [Group G]
  (hG : ∀ H : Subgroup G, H = ⊤ ∨ H = ⊥) :
  IsCyclic G ∧ ∃ (p : ℕ) (Fin : Fintype G), Nat.Prime p ∧ @card G Fin = p := by
  sorry

/-
The formal statement above is false because the trivial group `PUnit` satisfies the hypothesis
`∀ H, H = ⊤ ∨ H = ⊥`, yet its cardinality is `1`, which is not a prime number. Therefore the
promised prime-order conclusion fails even though the assumption holds.
-/

lemma exercise_2_3_16_punit_condition (H : Subgroup PUnit) :
    H = ⊤ ∨ H = ⊥ := by
  -- Step 1: The identity element `()` necessarily belongs to every subgroup.
  have hx : (PUnit.unit : PUnit) ∈ H := by
    -- Step 1.1: Membership follows immediately from `H.one_mem`.
    simpa using H.one_mem
  -- Step 2: Since `PUnit` has only one element, `H` must coincide with `⊤ = ⊥`.
  refine Or.inl ?_
  -- Step 2.1: Use extensionality to identify `H` with `⊤`.
  ext x
  -- Step 2.2: Reduce to the unique inhabitant of `PUnit`.
  cases x
  -- Step 2.3: Simplify the resulting membership statements.
  simp [hx]

lemma exercise_2_3_16_punit_counter :
    ¬ (IsCyclic PUnit ∧
        ∃ p : ℕ, ∃ Fin : Fintype PUnit, Nat.Prime p ∧ @card PUnit Fin = p) := by
  classical
  -- Step 1: Assume the impossible conclusion and extract its components.
  rintro ⟨_, ⟨p, Fin, hp, hcard⟩⟩
  -- Step 2: Show that every finite structure on `PUnit` has exactly one element.
  have hcard1 : @Fintype.card PUnit Fin = 1 := by
    -- Step 2.1: Temporarily register `Fin` as the local `Fintype` instance.
    let _ : Fintype PUnit := Fin
    -- Step 2.2: Use the general lemma for `Unique` types.
    simp
  -- Step 3: Conclude that the supposed prime `p` is equal to `1`, contradicting primality.
  have hp_eq : p = 1 := by
    -- Step 3.1: Rewrite `hcard` with the explicit value of the cardinality.
    simpa [hcard1] using hcard.symm
  -- Step 3.2: Contradict the fact that a prime number cannot equal `1`.
  exact hp.ne_one hp_eq

/-- Step 1: State and prove the formal negation of the original (incorrect) claim. -/
theorem Herstein_exercise_2_3_16_neg :
    ¬ (∀ (G : Type*) (_ : Group G),
        (∀ H : Subgroup G, H = ⊤ ∨ H = ⊥) →
          (IsCyclic G ∧ ∃ p : ℕ, ∃ Fin : Fintype G,
            Nat.Prime p ∧ @card G Fin = p)) := by
  classical
  -- Step 1: Assume the universal statement in order to derive a contradiction.
  intro h
  -- Step 2: Apply it to the trivial group `PUnit`, which satisfies the hypothesis.
  have hP := h PUnit inferInstance (fun H => exercise_2_3_16_punit_condition H)
  -- Step 3: Invoke the previously proved counterexample to reach `False`.
  exact exercise_2_3_16_punit_counter hP

/-
## Why the Previous Corrected Statement is Still Not Faithful

The previous corrected statement assumed `[Fintype G]` (finiteness) as a hypothesis:

    {G : Type*} [Group G] [Fintype G]
    (hG : ∀ H : Subgroup G, H = ⊤ ∨ H = ⊥)
    (h_nontrivial : ∃ g : G, g ≠ (1 : G))

However, the informal statement says "If a group G has no proper subgroups, prove that G is
cyclic of order p, where p is a prime number." Finiteness of G is NOT a hypothesis — it is
part of what must be derived (having order p for some prime p implies G is finite). The `[Fintype G]`
assumption strictly reduces what must be proved, making the Lean version logically weaker than the
informal claim: the informal theorem implies the Lean theorem, but not conversely.

## Correction

We remove `[Fintype G]` from the hypotheses so that finiteness must be derived as part of the
proof. The conclusion uses `Nat.card G = p` (which equals 0 for infinite types, so asserting it
equals a prime implicitly proves finiteness). We keep the nontriviality assumption to rule out the
trivial group (which vacuously satisfies the subgroup condition but has order 1, not prime).

The proof proceeds:
  1. Show G is cyclic (zpowers g = ⊤ for any g ≠ 1).
  2. Derive that g has finite order (otherwise zpowers(g^2) would be a proper nontrivial
     subgroup, contradicting the hypothesis).
  3. Conclude Nat.card G = orderOf g, and show this is prime using the subgroup dichotomy.
-/

theorem Herstein_exercise_2_3_16_corrected
    {G : Type*} [Group G]
    (hG : ∀ H : Subgroup G, H = ⊤ ∨ H = ⊥)
    (h_nontrivial : ∃ g : G, g ≠ (1 : G)) :
    IsCyclic G ∧ ∃ p : ℕ, Nat.Prime p ∧ Nat.card G = p := by
  classical
  -- Step 1: Choose an explicit non-identity element.
  obtain ⟨g, hg⟩ := h_nontrivial
  -- Step 1.1: Show that the subgroup generated by `g` cannot be `⊥`, hence must be `⊤`.
  have hzpow_top : Subgroup.zpowers g = ⊤ := by
    -- Step 1.1.1: Apply the dichotomy supplied by the hypothesis to `zpowers g`.
    rcases hG (Subgroup.zpowers g) with hz | hz
    · exact hz
    · -- Step 1.1.2: If the subgroup were `⊥`, then `g = 1`, contradicting `hg`.
      have hg_mem_bot :
          g ∈ (⊥ : Subgroup G) := by
        -- Step 1.1.2.1: Rewrite the membership of `g` in `zpowers g`.
        simpa [hz] using (Subgroup.mem_zpowers (g := g))
      -- Step 1.1.2.2: Simplify membership in `⊥` to obtain the contradiction.
      have : g = (1 : G) := by
        simpa using (Subgroup.mem_bot.mp hg_mem_bot)
      exact (hg this).elim
  -- Step 2: Deduce that `G` is cyclic because `zpowers g = ⊤`.
  have hcyc : IsCyclic G :=
    (isCyclic_iff_exists_zpowers_eq_top (α := G)).2 ⟨g, hzpow_top⟩
  -- Step 3: Show that `g` has finite order (orderOf g ≠ 0).
  --         Proof by contradiction: if g has infinite order, then zpowers(g²) is a proper
  --         nontrivial subgroup, violating the hypothesis.
  have hfin_order : orderOf g ≠ 0 := by
    intro h_inf
    -- Step 3.1: Since g has infinite order, g² ≠ 1 (by orderOf_eq_zero_iff').
    have hg2_ne : g ^ 2 ≠ 1 :=
      orderOf_eq_zero_iff'.mp h_inf 2 (by norm_num)
    -- Step 3.2: Therefore zpowers(g²) ≠ ⊥.
    have hne_bot : Subgroup.zpowers (g ^ 2) ≠ ⊥ := by
      intro h
      exact hg2_ne (Subgroup.mem_bot.mp (h ▸ Subgroup.mem_zpowers (g ^ 2)))
    -- Step 3.3: By the subgroup dichotomy, zpowers(g²) = ⊤.
    have hzpow2_top : Subgroup.zpowers (g ^ 2) = ⊤ := by
      rcases hG (Subgroup.zpowers (g ^ 2)) with h | h
      · exact h
      · exact absurd h hne_bot
    -- Step 3.4: Since zpowers(g²) = ⊤, we have g ∈ zpowers(g²).
    have hg_mem : g ∈ Subgroup.zpowers (g ^ 2) := hzpow2_top ▸ Subgroup.mem_top g
    -- Step 3.5: Unpack membership: ∃ k : ℤ, (g²)^k = g.
    rw [Subgroup.mem_zpowers_iff] at hg_mem
    obtain ⟨k, hk⟩ := hg_mem
    -- Step 3.6: From (g²)^k = g, derive g^(2k-1) = 1.
    have h_one : g ^ (2 * k - 1 : ℤ) = 1 := by
      have hgpow : g ^ (2 * k : ℤ) = g := by
        calc g ^ (2 * k : ℤ) = (g ^ (2 : ℤ)) ^ k := by rw [zpow_mul]
          _ = (g ^ (2 : ℕ)) ^ k := by norm_cast
          _ = g := hk
      -- Step 3.6.1: Multiply both sides of g^(2k) = g by g⁻¹ on the right.
      have : g ^ (2 * k : ℤ) * g⁻¹ = 1 := by
        rw [hgpow, mul_inv_cancel]
      -- Step 3.6.2: Rewrite g⁻¹ as g^(-1) and combine exponents.
      rwa [show g⁻¹ = g ^ (-1 : ℤ) from (zpow_neg_one g).symm,
           ← zpow_add, show 2 * k + (-1 : ℤ) = 2 * k - 1 from by ring] at this
    -- Step 3.7: Since g has infinite order, g^n = 1 only when n = 0.
    --           So 2k - 1 = 0, but 2k - 1 is odd — contradiction.
    have h_zero : (2 * k - 1 : ℤ) = 0 := by
      have h_dvd : (orderOf g : ℤ) ∣ (2 * k - 1) :=
        orderOf_dvd_iff_zpow_eq_one.mpr h_one
      simp [h_inf] at h_dvd
      exact h_dvd
    omega
  -- Step 4: Derive that G is finite.
  --         Since orderOf g ≠ 0, the subgroup zpowers g is finite. Since zpowers g = ⊤ = G,
  --         the group G itself is finite.
  have hfinG : Finite G := by
    -- Step 4.1: zpowers g is finite (its Nat.card equals orderOf g ≠ 0).
    have hfin_zpow : Finite ↥(Subgroup.zpowers g) := by
      have : Nat.card ↥(Subgroup.zpowers g) ≠ 0 := by
        rw [Nat.card_zpowers]; exact hfin_order
      exact Nat.finite_of_card_ne_zero this
    -- Step 4.2: Since zpowers g = ⊤, the type ↥⊤ is finite.
    have hfin_top : Finite ↥(⊤ : Subgroup G) := hzpow_top ▸ hfin_zpow
    -- Step 4.3: Transfer finiteness from ↥⊤ to G via the canonical equivalence.
    exact Finite.of_equiv _ Subgroup.topEquiv.toEquiv
  -- Step 5: Obtain a Fintype instance for subsequent cardinality arguments.
  haveI : Fintype G := Fintype.ofFinite G
  -- Step 6: Record that the group is genuinely nontrivial.
  have hnontrivialG : Nontrivial G := ⟨⟨g, 1, hg⟩⟩
  -- Step 7: Translate nontriviality into a concrete inequality on the cardinality.
  have hcard_gt_one : 1 < Nat.card G := by
    -- Step 7.1: Use the standard characterization for finite types.
    simpa [Nat.card_eq_fintype_card] using
      (Fintype.one_lt_card_iff_nontrivial (α := G)).2 hnontrivialG
  -- Step 8: Obtain a generator whose order equals the cardinality.
  obtain ⟨g₀, hg₀⟩ :=
    (isCyclic_iff_exists_orderOf_eq_natCard (α := G)).mp hcyc
  -- Step 8.1: Name the cardinality once and for all.
  set n := Nat.card G
  have hg₀_order : orderOf g₀ = n := by
    -- Step 8.1.1: Rewrite using the definition of `n`.
    simpa [n] using hg₀
  -- Step 9: Prove that `n` is prime via the characterization using divisors.
  have hprime_n : Nat.Prime n := by
    -- Step 9.1: Convert `1 < n` into the `2 ≤ n` part required by `Nat.prime_def`.
    have hn_le : 2 ≤ n := Nat.succ_le_of_lt (by simpa [n] using hcard_gt_one)
    -- Step 9.2: Establish the gcd condition for every divisor of `n`.
    refine (Nat.prime_def).2 ⟨hn_le, ?_⟩
    -- Step 9.2.1: Let `m` be any divisor of `n`, and analyze the quotient.
    intro m hm
    rcases hm with ⟨k, hk⟩
    -- Step 9.2.2: Handle the trivial divisor.
    by_cases hm_one : m = 1
    · exact Or.inl hm_one
    ·
      -- Step 9.2.3: Rule out the case `k = 0`, which would contradict `n ≠ 0`.
      have hcard_ne_zero : n ≠ 0 := by
        -- Step 9.2.3.1: Cardinality of a nonempty finite type cannot be zero.
        have : Fintype.card G ≠ 0 := Fintype.card_ne_zero
        simp [n, Nat.card_eq_fintype_card, this]
      have hk_ne_zero : k ≠ 0 := by
        intro hk0
        have : n = 0 := by simpa [hk0] using hk
        exact hcard_ne_zero this
      -- Step 9.2.4: Compute the order of `g₀ ^ k`.
      have hk_dvd : k ∣ n := by
        refine ⟨m, ?_⟩
        simpa [n, Nat.mul_comm] using hk
      have hgcd : Nat.gcd n k = k := Nat.gcd_eq_right hk_dvd
      have hk_pos : 0 < k := Nat.pos_of_ne_zero hk_ne_zero
      have horder_pow :
          orderOf (g₀ ^ k) = m := by
        have hpow :
            orderOf (g₀ ^ k) =
              orderOf g₀ / Nat.gcd (orderOf g₀) k :=
          orderOf_pow (x := g₀) (n := k)
        -- Step 9.2.4.1: Simplify using `orderOf g₀ = n` and the gcd calculation.
        have hquot : n / k = m := by
          -- Step 9.2.4.1.1: Compare the two decompositions of `n`.
          have hdiv :
              k * (n / k) = n := by
            simpa [Nat.mul_comm] using (Nat.mul_div_cancel' hk_dvd)
          have hmul : k * m = n := by
            simpa [Nat.mul_comm] using hk.symm
          -- Step 9.2.4.1.2: Cancel the common factor `k` (which is nonzero).
          have hcancel :
              k * (n / k) = k * m := by
            calc
              k * (n / k) = n := hdiv
              _ = k * m := hmul.symm
          exact Nat.mul_left_cancel hk_pos hcancel
        -- Step 9.2.4.1.3: Finish the simplification.
        simpa [hg₀_order, hgcd, hquot] using hpow
      -- Step 9.2.5: Use the subgroup dichotomy on `zpowers (g₀ ^ k)`.
      have hzpow_k_top : Subgroup.zpowers (g₀ ^ k) = ⊤ := by
        -- Step 9.2.5.1: Apply `hG` and dismiss the `⊥` case via the nontrivial order.
        rcases hG (Subgroup.zpowers (g₀ ^ k)) with htop | hbot
        · exact htop
        · have : g₀ ^ k = (1 : G) := by
            have hmem :
                g₀ ^ k ∈ (⊥ : Subgroup G) := by
              simpa [hbot] using (Subgroup.mem_zpowers (g := g₀ ^ k))
            simpa using (Subgroup.mem_bot.mp hmem)
          -- Step 9.2.5.2: Contradict the assumption that `m ≠ 1`.
          have horder_one : orderOf (g₀ ^ k) = 1 := by
            simp [this]
          exact (hm_one (by simpa [horder_pow] using horder_one)).elim
      -- Step 9.2.6: Translate `zpowers = ⊤` into an equality of cardinalities.
      have horders_eq :
          orderOf (g₀ ^ k) = n := by
        -- Step 9.2.6.1: Compare the cardinalities of the subgroup and of `G`.
        have hfin_card :
            Fintype.card ↥(Subgroup.zpowers (g₀ ^ k)) = Fintype.card G := by
          -- Step 9.2.6.1.1: Apply the characterization of `⊤`.
          simp [hzpow_k_top]
        -- Step 9.2.6.2: Use `Fintype.card_zpowers` to convert back to an order statement.
        have hord_eq_card :
            orderOf (g₀ ^ k) = Fintype.card G := by
          simpa [Fintype.card_zpowers] using hfin_card
        simpa [n, Nat.card_eq_fintype_card] using hord_eq_card
      -- Step 9.2.7: Conclude that `m = n`, because both equal the order of the same generator.
      exact Or.inr (by simpa [horder_pow] using horders_eq)
  -- Step 10: Assemble the final cyclic and prime-order conclusion.
  exact ⟨hcyc, n, hprime_n, rfl⟩
