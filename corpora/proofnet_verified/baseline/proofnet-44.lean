import Mathlib

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators



/-Informal Statement

Prove that if $G$ is an abelian simple group then $G \cong Z_{p}$ for some prime $p$ (do not assume $G$ is a finite group).
-/

/-Informal Proof

Solution: Let $G$ be an abelian simple group.
Suppose $G$ is infinite. If $x \in G$ is a nonidentity element of finite order, then $\langle x\rangle<G$ is a nontrivial normal subgroup, hence $G$ is not simple. If $x \in G$ is an element of infinite order, then $\left\langle x^2\right\rangle$ is a nontrivial normal subgroup, so $G$ is not simple.

Suppose $G$ is finite; say $|G|=n$. If $n$ is composite, say $n=p m$ for some prime $p$ with $m \neq 1$, then by Cauchy's Theorem $G$ contains an element $x$ of order $p$ and $\langle x\rangle$ is a nontrivial normal subgroup. Hence $G$ is not simple. Thus if $G$ is an abelian simple group, then $|G|=p$ is prime. We saw previously that the only such group up to isomorphism is $\mathbb{Z} /(p)$, so that $G \cong \mathbb{Z} /(p)$. Moreover, these groups are indeed simple.
-/

theorem Dummit_Foote_exercise_3_4_1 (G : Type*) [CommGroup G] [IsSimpleGroup G] :
    IsCyclic G ∧ ∃ G_fin : Fintype G, Nat.Prime (@card G G_fin) := by
  classical
  -- Step 1: Invoke the general classification that every simple commutative group is cyclic.
  have h_cyclic : IsCyclic G := inferInstance
  -- Step 2: Extract an explicit generator witnessing the cyclic structure.
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  -- Step 2.1: Record that the subgroup generated by g is the whole group.
  have h_zpowers_top : Subgroup.zpowers g = ⊤ := (Subgroup.eq_top_iff' _).2 hg
  -- Step 2.2: Deduce that the chosen generator cannot be the identity element.
  have hg_ne_one : g ≠ (1 : G) := by
    intro h
    simp [h] at h_zpowers_top
  -- Step 3: Prove that g has finite order; otherwise we contradict simplicity.
  have h_order_ne_zero : orderOf g ≠ 0 := by
    -- Step 3.1: Assume towards contradiction that g has infinite order.
    intro h_zero
    -- Step 3.2: Consider the subgroup generated by g², which is automatically normal.
    let H : Subgroup G := Subgroup.zpowers (g ^ 2)
    have hH_normal : H.Normal := H.normal_of_comm
    -- Step 3.3: Show that g² is nontrivial, so H is not the trivial subgroup.
    have hg2_ne_one : g ^ 2 ≠ (1 : G) := by
      have := (orderOf_eq_zero_iff').1 h_zero 2 (by decide : (0 : ℕ) < 2)
      simpa using this
    have hH_nonbot : H ≠ ⊥ := by
      refine (Subgroup.zpowers_ne_bot).2 ?_
      simpa [H] using hg2_ne_one
    -- Step 3.4: Show that g is not contained in H, so H cannot be the whole group.
    have hg_not_mem : g ∉ H := by
      intro hg_mem
      rcases Subgroup.mem_zpowers_iff.mp hg_mem with ⟨k, hk⟩
      cases k with
      | ofNat m =>
          -- Step 3.4.1: Handle the case of a nonnegative exponent.
          have hk_nat : (g ^ 2) ^ m = g := by
            simpa [zpow_natCast] using hk
          have hk_pow : g ^ (2 * m) = g := by
            simpa [pow_mul] using hk_nat
          have hk_eq' : g ^ (2 * m) = g ^ (1 : ℕ) := by
            simpa [pow_one] using hk_pow
          have hk_eq : 2 * m = 1 :=
            (pow_inj_iff_of_orderOf_eq_zero h_zero).1 hk_eq'
          have : 2 ∣ 1 := ⟨m, by simpa [Nat.mul_comm] using hk_eq.symm⟩
          exact Nat.Prime.not_dvd_one Nat.prime_two this
      | negSucc m =>
          -- Step 3.4.2: Handle the case of a negative exponent.
          have hk_neg : (g ^ 2) ^ (Int.negSucc m) = g := hk
          have hk_pos : (g ^ 2) ^ (m + 1) = g⁻¹ := by
            have hk_inv : ((g ^ 2) ^ (m + 1))⁻¹ = g := by
              simpa [zpow_negSucc] using hk_neg
            simpa using congrArg Inv.inv hk_inv
          have hk_pow : g ^ (2 * (m + 1)) = g⁻¹ := by
            simpa [pow_mul] using hk_pos
          have hk_one : g ^ (2 * (m + 1) + 1) = (1 : G) := by
            calc
              g ^ (2 * (m + 1) + 1)
                  = g ^ (2 * (m + 1)) * g := by
                      simp [pow_succ]
              _ = g⁻¹ * g := by simp [hk_pow]
              _ = 1 := by simp
          have hpos : 0 < 2 * (m + 1) + 1 := Nat.succ_pos _
          have hcontr :=
            (orderOf_eq_zero_iff').1 h_zero (2 * (m + 1) + 1) hpos
          exact hcontr hk_one
    have hH_not_top : H ≠ ⊤ := by
      intro h_top
      have : g ∈ H := by
        have : g ∈ (⊤ : Subgroup G) := Subgroup.mem_top g
        simp [H, h_top]
      exact hg_not_mem this
    -- Step 3.5: Contradict simplicity by exhibiting the nontrivial proper normal subgroup H.
    have hH := Subgroup.Normal.eq_bot_or_eq_top (H := H) hH_normal
    cases hH with
    | inl h_bot => exact hH_nonbot h_bot
    | inr h_top => exact hH_not_top h_top
  -- Step 4: Relate the cardinality of G to the order of g.
  have h_card_eq : orderOf g = Nat.card G := orderOf_eq_card_of_forall_mem_zpowers hg
  -- Step 4.1: Use the nonvanishing order to deduce that G is finite.
  have h_card_ne_zero : Nat.card G ≠ 0 := by
    have := h_order_ne_zero
    simpa [h_card_eq] using this
  have h_fin : (Finite G) := Nat.finite_of_card_ne_zero h_card_ne_zero
  -- Step 5: Package the finite structure as an explicit Fintype instance.
  classical
  let G_fin : Fintype G := Fintype.ofFinite G
  -- Step 6: Transfer the prime-order conclusion from the simple finite classification.
  have h_prime_nat : Nat.Prime (Nat.card G) := by
    letI : Fintype G := G_fin
    simpa [Nat.card_eq_fintype_card] using (IsSimpleGroup.prime_card (α := G))
  have h_prime_card : Nat.Prime (@Fintype.card G G_fin) := by
    letI : Fintype G := G_fin
    simpa [Nat.card_eq_fintype_card] using h_prime_nat
  -- Step 7: Conclude the desired pair of statements.
  exact ⟨h_cyclic, ⟨G_fin, h_prime_card⟩⟩
