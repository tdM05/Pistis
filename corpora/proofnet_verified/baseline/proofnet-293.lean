import Mathlib

open Filter Set TopologicalSpace
open scoped Topology



/-Informal Statement

Show that the collection $\{(a,b) \mid a < b, a \text{ and } b \text{ rational}\}$ is a basis that generates the standard topology on $\mathbb{R}$.
-/

/-Informal Proof

Exercise 13.8. (a) First note that $\mathcal{B}$ is a basis for a topology on $\mathbb{R}$. This follows from the fact that the union of its elements is all of $\mathbb{R}$ and the intersection of two elements of $\mathcal{B}$ is either empty or another element of $\mathcal{B}$. Let $\mathcal{T}$ be the standard topology on $\mathbb{R}$. Clearly the topology generated by $\mathcal{B}$ is coarser than $\mathcal{T}$. Let $U \in \mathcal{T}$ and $x \in U$. Then $U$ contains an open interval with centre $x$. Since the rationals are dense in $\mathbb{R}$ with the standard topology, there exists $q \in \mathbb{Q}$ such that $x \in(x-q, x+q) \subset U$. This proves that $\mathcal{T}$ is coarser than the topology generated by $\mathcal{B}$. We conclude that $\mathcal{B}$ generates the standard topology on $\mathbb{R}$.
-/

theorem Munkres_exercise_13_8a :
  IsTopologicalBasis {S : Set ℝ | ∃ a b : ℚ, a < b ∧ S = Ioo ↑a ↑b} := by
  classical
  -- Step 1: Re-express the described family as the explicit triple union used in mathlib.
  have h_eq :
      {S : Set ℝ | ∃ a b : ℚ, a < b ∧ S = Ioo (a : ℝ) (b : ℝ)} =
        ⋃ (a : ℚ) (b : ℚ) (_ : a < b), {Ioo (a : ℝ) (b : ℝ)} := by
    -- Step 1.1: Prove the inclusion from left to right by unpacking the existential witness.
    ext S; constructor
    · rintro ⟨a, b, hab, rfl⟩
      -- Step 1.1.1: Choose the witnesses `a`, `b`, and `hab` to enter the triple union.
      refine mem_iUnion.2 ?_
      refine ⟨a, mem_iUnion.2 ?_⟩
      refine ⟨b, mem_iUnion.2 ?_⟩
      refine ⟨hab, ?_⟩
      -- Step 1.1.2: Reduce membership in the last singleton to reflexivity.
      simp [mem_singleton_iff]
    -- Step 1.2: Prove the inclusion from right to left by projecting the witnesses.
    · intro hS
      -- Step 1.2.1: Decompose the membership in the triple union to obtain rational endpoints.
      rcases mem_iUnion.1 hS with ⟨a, hS⟩
      rcases mem_iUnion.1 hS with ⟨b, hS⟩
      rcases mem_iUnion.1 hS with ⟨hab, hS⟩
      -- Step 1.2.2: The last membership says exactly that the set equals the open interval.
      have hS' : S = Ioo (a : ℝ) (b : ℝ) := by
        simpa [mem_singleton_iff] using hS
      exact ⟨a, b, hab, hS'⟩
  -- Step 2: Invoke the existing mathlib lemma for the triple union of rational open intervals.
  -- Step 3: Rewrite back using `h_eq` so the result matches the statement's formulation.
  simpa [h_eq] using Real.isTopologicalBasis_Ioo_rat
