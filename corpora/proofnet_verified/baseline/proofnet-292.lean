import Mathlib

open Filter Set TopologicalSpace
open scoped Topology

def is_topology (X : Type*) (T : Set (Set X)) :=
  univ ∈ T ∧
  (∀ s t, s ∈ T → t ∈ T → s ∩ t ∈ T) ∧
  (∀s, (∀t ∈ s, t ∈ T) → sUnion s ∈ T)

/-Informal Statement

Show that if $\mathcal{A}$ is a subbasis for a topology on $X$, then the topology generated by $\mathcal{A}$ equals the intersection of all topologies on $X$ that contain $\mathcal{A}$.
-/

/-Informal Proof

If we now considered $\mathcal{A}$ as a subbasis, then the elements of $\mathcal{T}$ are union of finite intersections of elements of $\mathcal{A}$. The inclusion $\mathcal{O} \subset \mathcal{T}$ is again clear and $\mathcal{T} \subset \mathcal{O}$ holds since every union of finite intersections of elements of $\mathcal{A}$ belongs to $\mathcal{O}$.
-/

theorem Munkres_exercise_13_5b {X : Type*} (A : Set (Set X)) :
  generateFrom A = generateFrom (sInter {T | is_topology X T ∧ A ⊆ T}) := by
  classical
  -- Step 1: Introduce the family `S` of all candidate topologies on `X` that contain `A`.
  set S : Set (Set (Set X)) := {T | is_topology X T ∧ A ⊆ T} with hSdef
  -- Step 1.1: Record that each generator in `A` belongs to the raw intersection `sInter S`.
  have hA_subset : A ⊆ sInter S := by
    -- Step 1.1.1: Fix an arbitrary generator `U ∈ A`.
    intro U hU
    -- Step 1.1.2: Use the universal property of `sInter` to show `U` lies in every `T ∈ S`.
    refine mem_sInter.2 ?_
    -- Step 1.1.3: Specialize to an arbitrary topology `T` in `S`.
    intro T hT
    -- Step 1.1.4: Apply the containment clause `A ⊆ T`.
    exact hT.2 hU
  -- Step 2: Verify that the collection of sets open in `generateFrom A` satisfies `is_topology`.
  have hTopo : is_topology X {U | IsOpen[generateFrom A] U} := by
    -- Step 2.1: Unpack the `is_topology` structure into the three axioms.
    refine ⟨?_, ?_, ?_⟩
    · -- Step 2.1.1: Show that the whole space is open.
      change TopologicalSpace.GenerateOpen A (Set.univ : Set X)
      exact TopologicalSpace.GenerateOpen.univ
    · -- Step 2.2.1: Show closure under binary intersections.
      intro s t hs ht
      -- Step 2.2.2: Reinterpret the hypotheses via the inductive predicate.
      have hs' : TopologicalSpace.GenerateOpen A s := by
        simpa [Set.mem_setOf_eq] using hs
      have ht' : TopologicalSpace.GenerateOpen A t := by
        simpa [Set.mem_setOf_eq] using ht
      -- Step 2.2.3: Apply the intersection constructor directly.
      change TopologicalSpace.GenerateOpen A (s ∩ t)
      exact TopologicalSpace.GenerateOpen.inter s t hs' ht'
    · -- Step 2.3.1: Show closure under arbitrary unions.
      intro 𝒰 h𝒰
      -- Step 2.3.2: Convert the hypotheses into the inductive predicate.
      have h𝒰' : ∀ s ∈ 𝒰, TopologicalSpace.GenerateOpen A s := by
        intro s hs
        simpa [Set.mem_setOf_eq] using h𝒰 s hs
      -- Step 2.3.3: Apply the union constructor.
      change TopologicalSpace.GenerateOpen A (sUnion 𝒰)
      exact TopologicalSpace.GenerateOpen.sUnion 𝒰 h𝒰'
  -- Step 3: Observe that every set in `A` is automatically open for `generateFrom A`.
  have hA_open : A ⊆ {U | IsOpen[generateFrom A] U} := by
    -- Step 3.1: Fix `U ∈ A`.
    intro U hU
    -- Step 3.2: Use the `basic` constructor of `GenerateOpen`.
    change TopologicalSpace.GenerateOpen A U
    exact TopologicalSpace.GenerateOpen.basic _ hU
  -- Step 4: Identify that any set in the intersection is open under `generateFrom A`.
  have hInter_subset :
      sInter S ⊆ {U | IsOpen[generateFrom A] U} := by
    -- Step 4.1: Fix `U` in the intersection.
    intro U hU
    -- Step 4.2: Show that the open sets of `generateFrom A` themselves form an element of `S`.
    have hT_mem : {U | IsOpen[generateFrom A] U} ∈ S := by
      -- Step 4.2.1: Unfold membership in `S` and plug in the data amassed so far.
      change is_topology X {U | IsOpen[generateFrom A] U} ∧
            A ⊆ {U | IsOpen[generateFrom A] U}
      exact ⟨hTopo, hA_open⟩
    -- Step 4.3: Specialize the intersection membership with `hT_mem`.
    exact (mem_sInter.1 hU) _ hT_mem
  -- Step 5: Use the Galois connection for `generateFrom` to derive both inequalities.
  have h_le : generateFrom A ≤ generateFrom (sInter S) := by
    -- Step 5.1: Apply the characterization `t ≤ generateFrom B ↔ B ⊆ {open sets of t}`.
    refine (le_generateFrom_iff_subset_isOpen).2 ?_
    -- Step 5.1.1: Supply the inclusion proven in Step 4.
    exact hInter_subset
  -- Step 5.2: Each element of `A` is open in the topology generated by `sInter S`.
  have hA_in_target : A ⊆ {U | IsOpen[generateFrom (sInter S)] U} := by
    -- Step 5.2.1: Fix `U ∈ A`.
    intro U hU
    -- Step 5.2.2: First note that `U` lies inside `sInter S`.
    have hU_mem : U ∈ sInter S := hA_subset hU
    -- Step 5.2.3: Use the `basic` constructor relative to the new generating family.
    change TopologicalSpace.GenerateOpen (sInter S) U
    exact TopologicalSpace.GenerateOpen.basic _ hU_mem
  have h_ge : generateFrom (sInter S) ≤ generateFrom A := by
    -- Step 5.3: Apply the same characterization as in Step 5.1.
    refine (le_generateFrom_iff_subset_isOpen).2 ?_
    -- Step 5.3.1: Feed in the inclusion from Step 5.2.
    exact hA_in_target
  -- Step 6: Combine both inequalities for the final equality.
  exact le_antisymm h_le h_ge
