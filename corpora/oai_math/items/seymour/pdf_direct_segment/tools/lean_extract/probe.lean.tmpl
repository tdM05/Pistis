
-- ── Expr → JSON extractor (appended to a copy of a .lean source file) ──
-- Walks the ELABORATED Expr of one declaration and emits a structured JSON tree
-- on a line prefixed with __EXTRACT__. Robust: operates on the kernel Expr (all
-- notation unfolded, implicits explicit), not on surface syntax.
--   kinds: forall | lam | app | const | var | sort | lit | let | proj | fvar | mvar
-- The driver (lean_extract.js) substitutes __DECL__ with the fully-qualified name.
section ExtractProbe
open Lean

partial def __exprToJson (names : List String) (e : Expr) : Json :=
  match e with
  | .bvar i => Json.mkObj [("kind", "var"), ("name", Json.str (names.getD i s!"#{i}"))]
  | .fvar _ => Json.mkObj [("kind", "fvar")]
  | .mvar _ => Json.mkObj [("kind", "mvar")]
  | .sort _ => Json.mkObj [("kind", "sort")]
  | .const n _ => Json.mkObj [("kind", "const"), ("name", Json.str n.toString)]
  | .lit (.natVal n) => Json.mkObj [("kind", "lit"), ("val", Json.str (toString n))]
  | .lit (.strVal s) => Json.mkObj [("kind", "lit"), ("val", Json.str s)]
  | .mdata _ e => __exprToJson names e
  | .proj s i e => Json.mkObj [("kind", "proj"), ("struct", Json.str s.toString), ("idx", Json.str (toString i)), ("on", __exprToJson names e)]
  | .app .. =>
      let fn := e.getAppFn
      let args := e.getAppArgs
      Json.mkObj [("kind", "app"), ("fn", __exprToJson names fn), ("args", Json.arr (args.map (__exprToJson names)))]
  | .lam n t b bi =>
      Json.mkObj [("kind", "lam"), ("binder", Json.str n.toString), ("info", Json.str (reprStr bi)), ("dom", __exprToJson names t), ("body", __exprToJson (n.toString :: names) b)]
  | .forallE n t b bi =>
      Json.mkObj [("kind", "forall"), ("binder", Json.str n.toString), ("info", Json.str (reprStr bi)), ("dom", __exprToJson names t), ("body", __exprToJson (n.toString :: names) b)]
  | .letE n t v b _ =>
      Json.mkObj [("kind", "let"), ("binder", Json.str n.toString), ("type", __exprToJson names t), ("value", __exprToJson names v), ("body", __exprToJson (n.toString :: names) b)]

open Lean Elab in
#eval show Lean.Elab.Command.CommandElabM Unit from do
  let declName := `__DECL__
  let env ← getEnv
  match env.find? declName with
  | none => IO.println "__EXTRACT_ERR__ declaration not found"
  | some ci =>
      let tyj := __exprToJson [] ci.type
      let valj := match ci.value? with | some v => __exprToJson [] v | none => Json.null
      let out := Json.mkObj [("name", Json.str declName.toString), ("type", tyj), ("value", valj)]
      IO.println s!"__EXTRACT__{out.compress}"

end ExtractProbe
