import Mathlib

open Fintype Set Real Ideal Polynomial
open scoped BigOperators



/-Informal Statement

Let $G$ be a group such that all subgroups of $G$ are normal in $G$. If $a, b \in G$, prove that $ba = a^jb$ for some $j$.
-/

/-Informal Proof

Let $G$ be a group where each subgroup is normal in $G$. let $a, b \in G$.
$$
\begin{aligned}
    \langle a\rangle\triangleright  G  &\Rightarrow b \cdot\langle a\rangle=\langle a\rangle \cdot b . \\
& \Rightarrow \quad b \cdot a=a^j \cdot b \text { for some } j \in \mathbb{Z}.
\end{aligned}
$$
(hence for $a_1 b \in G \quad a^j b=b \cdot a$ ).
-/

theorem Herstein_exercise_2_5_23 {G : Type*} [Group G]
  (hG : ∀ (H : Subgroup G), H.Normal) (a b : G) :
  ∃ (j : ℤ) , b*a = a^j * b:= by
  classical
  -- Step 1: Introduce the cyclic subgroup generated by `a` so that we can use the "all
  -- subgroups are normal" hypothesis on something concrete.
  have hHnormal : (Subgroup.zpowers a).Normal := hG (Subgroup.zpowers a)
  -- Step 1.1: Record that the generator `a` itself lies in that cyclic subgroup.
  have ha : a ∈ Subgroup.zpowers a := Subgroup.mem_zpowers a
  -- Step 2: Use normality to see that conjugating `a` by `b` still lands inside the same subgroup.
  have hb : b * a * b⁻¹ ∈ Subgroup.zpowers a := by
    -- Step 2.1: `Normal.conj_mem` exactly states that every conjugate of an element of a normal
    -- subgroup remains in that subgroup.
    simpa using hHnormal.conj_mem a ha b
  -- Step 3: Being in `⟨a⟩` means that this conjugate is some integer power of `a`.
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (by
    -- Step 3.1: Apply the characterization of membership in the cyclic subgroup.
    simpa using hb)
  -- Step 4: Rewriting `hj` yields the desired commutation relation `b * a = a^j * b`.
  refine ⟨j, ?_⟩
  -- Step 4.1: Rearrange the equality from Step 3 and cancel the trailing `b⁻¹`.
  calc
    b * a = (b * a) * (b⁻¹ * b) := by
      -- Step 4.1.1: Insert the identity element `b⁻¹ * b = 1`.
      simp
    _ = (b * a * b⁻¹) * b := by
      -- Step 4.1.2: Regroup the terms to exhibit the conjugate `b * a * b⁻¹`.
      simp [mul_assoc]
    _ = (a ^ j) * b := by
      -- Step 4.1.3: Substitute the description of the conjugate obtained in Step 3.
      simp [hj]
