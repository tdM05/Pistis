import Mathlib

open Filter Set TopologicalSpace
open scoped Topology

def is_topology (X : Type*) (T : Set (Set X)) :=
  univ ∈ T ∧
  (∀ s t, s ∈ T → t ∈ T → s ∩ t ∈ T) ∧
  (∀s, (∀t ∈ s, t ∈ T) → sUnion s ∈ T)

/-Informal Statement

Show that if $\mathcal{A}$ is a basis for a topology on $X$, then the topology generated by $\mathcal{A}$ equals the intersection of all topologies on $X$ that contain $\mathcal{A}$.
-/

/-Informal Proof

Let $\mathcal{T}$ be the topology generated by $\mathcal{A}$ and let $\mathcal{O}$ be the intersection of all topologies on $X$ that contains $\mathcal{A}$. Clearly $\mathcal{O} \subset \mathcal{T}$ since $\mathcal{T}$ is a topology on $X$ that contain $\mathcal{A}$. Conversely, let $U \in \mathcal{T}$, so that $U$ is a union of elements of $\mathcal{A}$. Since each of this elements is also an element of $\mathcal{O}$, their union $U$ belongs to $\mathcal{O}$. Thus $\mathcal{T} \subset \mathcal{O}$ and the equality holds.
-/


theorem Munkres_exercise_13_5a {X : Type*}
  [TopologicalSpace X] (A : Set (Set X)) (hA : IsTopologicalBasis A) :
  generateFrom A = generateFrom (sInter {T | is_topology X T ∧ A ⊆ T}) := by
  classical
  -- Step 1: Introduce the collection `S` of all candidate topologies that contain `A`.
  set S : Set (Set (Set X)) := {T | is_topology X T ∧ A ⊆ T} with hSdef
  -- Step 1.1: Establish that every generator in `A` belongs to the set-theoretic intersection of all `T ∈ S`.
  have hA_subset : A ⊆ sInter S := by
    -- Step 1.1.1: Fix an arbitrary set `U` in `A`.
    intro U hU
    -- Step 1.1.2: Translate membership in the intersection into membership in each `T ∈ S`.
    refine mem_sInter.2 ?_
    -- Step 1.1.3: For an arbitrary topology `T` in `S`, use the defining containment `A ⊆ T`.
    intro T hT
    exact hT.2 hU
  -- Step 2: Prove that the open sets of `generateFrom A` satisfy the raw topology axioms.
  have hTopo : is_topology X {U | IsOpen[generateFrom A] U} := by
    -- Step 2.1: Show that the whole space is open in `generateFrom A`.
    refine ⟨?_, ?_, ?_⟩
    · -- Step 2.1.1: Convert the goal to the constructor `GenerateOpen.univ`.
      change TopologicalSpace.GenerateOpen A (Set.univ : Set X)
      exact TopologicalSpace.GenerateOpen.univ
    -- Step 2.2: Verify closure under finite intersections.
    · -- Step 2.2.1: Take arbitrary open sets `s` and `t`.
      intro s t hs ht
      -- Step 2.2.2: Translate the hypotheses into the inductive predicate.
      have hs' : TopologicalSpace.GenerateOpen A s := by
        simpa [Set.mem_setOf_eq] using hs
      have ht' : TopologicalSpace.GenerateOpen A t := by
        simpa [Set.mem_setOf_eq] using ht
      -- Step 2.2.3: Apply the intersection constructor.
      change TopologicalSpace.GenerateOpen A (s ∩ t)
      exact TopologicalSpace.GenerateOpen.inter s t hs' ht'
    -- Step 2.3: Verify closure under arbitrary unions.
    · -- Step 2.3.1: Consider an arbitrary family `𝒰` of sets whose members are open.
      intro 𝒰 h𝒰
      -- Step 2.3.2: Convert each hypothesis into `GenerateOpen`.
      have h𝒰' : ∀ s ∈ 𝒰, TopologicalSpace.GenerateOpen A s := by
        intro s hs
        simpa [Set.mem_setOf_eq] using h𝒰 s hs
      -- Step 2.3.3: Apply the union constructor directly.
      change TopologicalSpace.GenerateOpen A (sUnion 𝒰)
      exact TopologicalSpace.GenerateOpen.sUnion 𝒰 h𝒰'
  -- Step 3: Record that every element of `A` is open in `generateFrom A`.
  have hA_open : A ⊆ {U | IsOpen[generateFrom A] U} := by
    -- Step 3.1: Fix an arbitrary `U ∈ A`.
    intro U hU
    -- Step 3.2: Use the basis assumption to see that `U` is open in the ambient topology.
    have hU_open : IsOpen U := hA.isOpen hU
    -- Step 3.3: Transport this openness to `generateFrom A` via `hA.eq_generateFrom`.
    simpa [Set.mem_setOf_eq, hA.eq_generateFrom] using hU_open
  -- Step 4: Show that sets in the intersection are open for `generateFrom A`.
  have hInter_subset :
      sInter S ⊆ {U | IsOpen[generateFrom A] U} := by
    -- Step 4.1: Fix an arbitrary `U` that lies in the intersection of all `T ∈ S`.
    intro U hU
    -- Step 4.2: Prove that the open sets of `generateFrom A` form an element of `S`.
    have hT_mem : {U | IsOpen[generateFrom A] U} ∈ S := by
      -- Step 4.2.1: Expand membership in `S` and reuse `hTopo` and `hA_open`.
      change is_topology X {U | IsOpen[generateFrom A] U} ∧ A ⊆ {U | IsOpen[generateFrom A] U}
      exact ⟨hTopo, hA_open⟩
    -- Step 4.3: Specialize the intersection membership to the witness obtained in Step 4.2.
    exact (mem_sInter.1 hU) _ hT_mem
  -- Step 5: Derive each inequality separately using Galois connections for `generateFrom`.
  have h_le : generateFrom A ≤ generateFrom (sInter S) := by
    -- Step 5.1: Apply the characterization `t ≤ generateFrom g ↔ g ⊆ {open sets of t}`.
    refine (le_generateFrom_iff_subset_isOpen).2 ?_
    -- Step 5.1.1: Reuse Step 4, which already provides the required inclusion.
    exact hInter_subset
  have hA_in_target : A ⊆ {U | IsOpen[generateFrom (sInter S)] U} := by
    -- Step 5.2: Show that each generator from `A` is open in the topology generated by `sInter S`.
    intro U hU
    change TopologicalSpace.GenerateOpen (sInter S) U
    exact TopologicalSpace.GenerateOpen.basic _ (hA_subset hU)
  have h_ge : generateFrom (sInter S) ≤ generateFrom A := by
    -- Step 5.3: Apply the same characterization to the reverse inclusion.
    refine (le_generateFrom_iff_subset_isOpen).2 ?_
    -- Step 5.3.1: Provide the inclusion established in the previous step.
    exact hA_in_target
  -- Step 6: Combine both inequalities to obtain the desired equality.
  exact le_antisymm h_le h_ge


/-
The original formalization has two issues:

1. The conclusion `generateFrom A = generateFrom (sInter {T | ...})` compares
   `generateFrom A` with the topology GENERATED BY the intersection, rather than
   comparing the open sets of `generateFrom A` directly with the intersection
   itself. The informal statement says the topology generated by A EQUALS the
   intersection of all topologies containing A — i.e., its open sets ARE that
   intersection.

2. The use of `[TopologicalSpace X]` and `(hA : IsTopologicalBasis A)` ties the
   statement to an ambient topology. The informal statement is about constructing
   a topology from A; no pre-existing topology is needed. However, the informal
   statement DOES explicitly say "if A is a basis for a topology on X" — this is
   an explicit premise that a faithful formalization should retain.

A corrected formulation:
- Encodes the basis hypothesis using raw axioms (covering + refinement) to avoid
  depending on an ambient topology via `IsTopologicalBasis`.
- Compares the open sets of `generateFrom A` directly with the intersection of
  all topologies containing A.
-/
theorem Munkres_exercise_13_5a_corrected {X : Type*}
  (A : Set (Set X))
  (_hcover : ∀ x : X, ∃ B ∈ A, x ∈ B)
  (_hrefine : ∀ B₁ ∈ A, ∀ B₂ ∈ A, ∀ x ∈ B₁ ∩ B₂, ∃ B₃ ∈ A, x ∈ B₃ ∧ B₃ ⊆ B₁ ∩ B₂) :
  {U : Set X | @IsOpen X (generateFrom A) U}
    =
  sInter {T : Set (Set X) | is_topology X T ∧ A ⊆ T} := by
  -- Step 1: Introduce abbreviations for the two sides.
  set τ := {U : Set X | @IsOpen X (generateFrom A) U} with hτ_def
  set S := {T : Set (Set X) | is_topology X T ∧ A ⊆ T} with hS_def
  -- Step 2: Prove equality by showing both subset inclusions.
  ext U
  simp only [Set.mem_sInter]
  constructor
  -- Step 3: (⊆) If U is open in generateFrom A, then U belongs to every topology containing A.
  · -- Step 3.1: Assume U is open in generateFrom A, and take an arbitrary topology T containing A.
    intro hU_open T hT
    -- Step 3.3: Proceed by induction on the GenerateOpen derivation of U.
    induction hU_open with
    | basic s hs =>
      -- Step 3.3.1: If U ∈ A, then U ∈ T since A ⊆ T.
      exact hT.2 hs
    | univ =>
      -- Step 3.3.2: univ ∈ T since T is a topology.
      exact hT.1.1
    | inter s t _ _ ih_s ih_t =>
      -- Step 3.3.3: s ∩ t ∈ T since T is closed under finite intersections.
      exact hT.1.2.1 s t ih_s ih_t
    | sUnion 𝒰 _ ih =>
      -- Step 3.3.4: ⋃₀ 𝒰 ∈ T since T is closed under arbitrary unions.
      exact hT.1.2.2 𝒰 (fun s hs => ih s hs)
  -- Step 4: (⊇) If U belongs to every topology containing A, then U is open in generateFrom A.
  · -- Step 4.1: Assume U belongs to every topology T ∈ S.
    intro hU_all
    -- Step 4.2: It suffices to show that τ is itself a topology containing A (hence a member of S).
    -- Step 4.2.1: Show that τ is a topology.
    have hτ_topo : is_topology X τ := by
      refine ⟨?_, ?_, ?_⟩
      -- Step 4.2.1.1: univ is open in generateFrom A.
      · exact TopologicalSpace.GenerateOpen.univ
      -- Step 4.2.1.2: Intersection of opens is open.
      · intro s t hs ht
        exact TopologicalSpace.GenerateOpen.inter s t hs ht
      -- Step 4.2.1.3: Union of opens is open.
      · intro 𝒰 h𝒰
        exact TopologicalSpace.GenerateOpen.sUnion 𝒰 h𝒰
    -- Step 4.2.2: Show that A ⊆ τ.
    have hA_sub_τ : A ⊆ τ := by
      intro V hV
      exact TopologicalSpace.GenerateOpen.basic V hV
    -- Step 4.3: Since τ ∈ S, and U belongs to every member of S, U ∈ τ.
    exact hU_all τ ⟨hτ_topo, hA_sub_τ⟩
