import Mathlib

open Function Fintype Subgroup Ideal Polynomial Submodule Zsqrtd
open scoped BigOperators



/-Informal Statement

Let $p$ be a prime integer. Prove that the polynomial $x^n-p$ is irreducible in $\mathbb{Q}[x]$.
-/

/-Informal Proof

Straightforward application of Eisenstein's criterion with $p$.
-/

theorem Artin_exercise_11_4_8 (p : ℕ) (hp : Prime p) (n : ℕ) (hn : n > 0) :
  Irreducible (X ^ n - (p : Polynomial ℚ) : Polynomial ℚ) := by
  -- Step 1: Work in classical logic and extract the basic numeric facts.
  classical
  -- Step 1.1: Record that the exponent `n` is strictly positive.
  have hnPos : 0 < n := hn
  -- Step 1.2: Remember that `p` is a prime in the sense of natural numbers.
  have hpNat : Nat.Prime p :=
    (Nat.irreducible_iff_nat_prime p).1 hp.irreducible
  -- Step 2: Define the integer polynomial and the relevant prime ideal.
  set fℤ : Polynomial ℤ := (X ^ n - Polynomial.C (p : ℤ))
  -- Step 2.1: Introduce the ideal generated by the prime `p`.
  set P : Ideal ℤ := Ideal.span {(p : ℤ)}
  -- Step 2.1.1: Verify that this ideal is prime.
  have hPprime : P.IsPrime := by
    -- Step 2.1.1.1: View the natural prime `p` as a prime element of `ℤ`.
    have hPrimeInt : Prime (p : ℤ) :=
      (Nat.prime_iff_prime_int).1 (by simpa using hpNat)
    -- Step 2.1.1.2: Use the principal ideal characterization of primeness.
    exact
      (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).2 hPrimeInt
  -- Step 2.2: Record that `fℤ` is monic, hence primitive.
  have hfZMonic : Monic fℤ := by
    -- Step 2.2.1: Apply the standard lemma for polynomials of the form `X^n - C a`.
    have hnNeZero : (n : ℕ) ≠ 0 := Nat.ne_of_gt hnPos
    simpa [fℤ] using
      (Polynomial.monic_X_pow_sub_C (R := ℤ) (a := (p : ℤ)) (n := n) hnNeZero)
  -- Step 2.2.2: Extract primitivity from monicity.
  have hfZPrim : fℤ.IsPrimitive := hfZMonic.isPrimitive
  -- Step 2.3: Compute useful auxiliary descriptions of `fℤ`.
  have hDegree :
      Polynomial.degree fℤ = (n : WithBot ℕ) := by
    -- Step 2.3.1: Employ the dedicated degree formula for `X^n - C a`.
    simpa [fℤ] using
      (Polynomial.degree_X_pow_sub_C (R := ℤ) (n := n) (a := (p : ℤ)) hnPos)
  -- Step 2.4: Show that the leading coefficient avoids the prime ideal.
  have hLeadNot : fℤ.leadingCoeff ∉ P := by
    -- Step 2.4.1: The leading coefficient equals `1`.
    have hLead : fℤ.leadingCoeff = (1 : ℤ) := hfZMonic.leadingCoeff
    -- Step 2.4.2: Derive a contradiction from the hypothetical membership.
    intro hMem
    -- Step 2.4.2.1: Translate ideal membership into divisibility.
    have hDiv : (p : ℤ) ∣ (1 : ℤ) := by
      have hOne : (1 : ℤ) ∈ P := by simpa [hLead] using hMem
      simpa [P] using (Ideal.mem_span_singleton).1 hOne
    -- Step 2.4.2.2: Move the divisibility statement to the natural numbers.
    obtain ⟨z, hz⟩ := hDiv
    have hzNat : 1 = p * Int.natAbs z := by
      have := congrArg Int.natAbs hz
      simpa [Int.natAbs_mul, Int.natAbs_one, Int.natAbs_natCast] using this
    have hNatDiv : p ∣ 1 := ⟨Int.natAbs z, hzNat⟩
    -- Step 2.4.2.3: Conclude with the basic property of a prime number.
    exact hpNat.not_dvd_one hNatDiv
  -- Step 2.5: Prove that all lower coefficients lie in the ideal `P`.
  have hCoeffs :
      ∀ m : ℕ, (m : WithBot ℕ) < Polynomial.degree fℤ → fℤ.coeff m ∈ P := by
    -- Step 2.5.1: Fix an arbitrary index below the degree.
    intro m hmDeg
    -- Step 2.5.2: Translate the degree bound into a strict inequality on naturals.
    have hmLt : m < n := by
      have : (m : WithBot ℕ) < (n : WithBot ℕ) := by simpa [hDegree] using hmDeg
      exact_mod_cast this
    -- Step 2.5.3: Analyse the two possible shapes of the index.
    by_cases hmZero : m = 0
    · -- Step 2.5.3.a: Handle the constant term.
      -- Step 2.5.3.a.i: Compute the constant coefficient explicitly.
      have hCoeff0 : fℤ.coeff 0 = -(p : ℤ) := by
        classical
        have hZeroNe : (0 : ℕ) ≠ n := Nat.ne_of_lt hnPos
        simp [fℤ, hZeroNe]
      -- Step 2.5.3.a.ii: Show that `-p` belongs to the ideal.
      have hIn : -(p : ℤ) ∈ P := by
        refine (Ideal.mem_span_singleton).2 ?_
        refine ⟨-1, ?_⟩
        simp
      -- Step 2.5.3.a.iii: Transport the membership back to the coefficient.
      simpa [hmZero, hCoeff0] using hIn
    · -- Step 2.5.3.b: Treat the strictly positive indices.
      have hmNeZero : m ≠ 0 := hmZero
      have hmNe : m ≠ n := Nat.ne_of_lt hmLt
      -- Step 2.5.3.b.i: Evaluate the coefficient, which vanishes.
      have hCoeff : fℤ.coeff m = 0 := by
        classical
        simp [fℤ, hmNeZero, hmNe]
      -- Step 2.5.3.b.ii: Use the ideal property that includes zero automatically.
      simp [hCoeff]
  -- Step 2.6: Confirm that the degree itself is strictly positive.
  have hDegPos : 0 < Polynomial.degree fℤ := by
    have : (0 : WithBot ℕ) < (n : WithBot ℕ) := by exact_mod_cast hnPos
    simpa [hDegree] using this
  -- Step 2.7: Verify that the constant coefficient avoids `P²`.
  have hConstNot : fℤ.coeff 0 ∉ P ^ 2 := by
    -- Step 2.7.1: Compute the constant coefficient once more.
    have hCoeff0 : fℤ.coeff 0 = -(p : ℤ) := by
      classical
      have hZeroNe : (0 : ℕ) ≠ n := Nat.ne_of_lt hnPos
      simp [fℤ, hZeroNe]
    -- Step 2.7.2: Assume, for contradiction, membership in the squared ideal.
    intro hMem
    -- Step 2.7.3: Turn the membership into a divisibility relation by `p²`.
    obtain ⟨k, hk⟩ :=
      (Ideal.mem_span_singleton).1
        (by simpa [P, Ideal.span_singleton_pow] using hMem)
    -- Step 2.7.4: Rewrite the equality in a more symmetric form.
    have hkNeg : (p : ℤ) = (p : ℤ) ^ 2 * (-k) := by
      have hk' : -(p : ℤ) = (p : ℤ) ^ 2 * k := by simpa [hCoeff0] using hk
      have hk'' := congrArg Neg.neg hk'
      simpa [pow_two, mul_comm, mul_left_comm, mul_assoc] using hk''
    -- Step 2.7.5: Cancel a factor of `p` to force a divisor of `1`.
    have hCancel :
        (1 : ℤ) = (p : ℤ) * (-k) := by
      have hpZ : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
      have hEq :
          (p : ℤ) * (1 : ℤ) = (p : ℤ) * ((p : ℤ) * (-k)) := by
        simpa [pow_two, mul_comm, mul_left_comm, mul_assoc] using hkNeg
      exact (mul_left_cancel₀ hpZ) hEq
    -- Step 2.7.6: Contradict the primeness by showing `p` divides `1`.
    have hDivOne : (p : ℤ) ∣ (1 : ℤ) := ⟨-k, by simpa using hCancel⟩
    have hNatDiv : p ∣ 1 := by
      obtain ⟨z, hz⟩ := hDivOne
      have hzNat : 1 = p * Int.natAbs z := by
        have := congrArg Int.natAbs hz
        simpa [Int.natAbs_mul, Int.natAbs_one, Int.natAbs_natCast] using this
      exact ⟨Int.natAbs z, hzNat⟩
    exact hpNat.not_dvd_one hNatDiv
  -- Step 3: Apply Eisenstein's criterion in `ℤ[x]`.
  have hIrredZ : Irreducible fℤ :=
    Polynomial.irreducible_of_eisenstein_criterion (f := fℤ) (P := P)
      hPprime hLeadNot hCoeffs hDegPos hConstNot hfZPrim
  -- Step 4: Transport irreducibility to `ℚ[x]` via Gauss's lemma.
  have hIrredQ :
      Irreducible (Polynomial.map (Int.castRingHom ℚ) fℤ) :=
    (Polynomial.IsPrimitive.Int.irreducible_iff_irreducible_map_cast hfZPrim).1 hIrredZ
  -- Step 5: Identify the mapped polynomial with the target statement.
  simpa [fℤ] using
    hIrredQ
