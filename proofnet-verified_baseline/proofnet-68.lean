import Mathlib
import Mathlib.Tactic.ComputeDegree
import Mathlib.Tactic.IntervalCases

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators



/-Informal Statement

Prove that $x^6+30x^5-15x^3 + 6x-120$ is irreducible in $\mathbb{Z}[x]$.
-/

/-Informal Proof

$$
x^6+30 x^5-15 x^3+6 x-120
$$
The coefficients of the low order.: $30,-15,0,6,-120$
They are divisible by the prime 3 , but $3^2=9$ doesn't divide $-120$. So this polynomial is irreducible over $\mathbb{Z}$.
-/

theorem Dummit_Foote_exercise_9_4_2b : Irreducible
  (X^6 + 30*X^5 - 15*X^3 + 6*X - 120 : Polynomial ℤ) := by
  /- Step 1: Introduce a name for the polynomial and the Eisenstein prime ideal. -/
  -- Step 1.1: Define the polynomial `f : ℤ[X]` whose irreducibility we want to prove.
  set f : Polynomial ℤ := X^6 + 30*X^5 - 15*X^3 + 6*X - 120 with hf_def
  -- Step 1.2: Define the ideal `P = (3)` in ℤ, which will be our Eisenstein prime ideal.
  let P : Ideal ℤ := Ideal.span ({(3 : ℤ)} : Set ℤ)

  /- Step 2: Show that `P` is a prime (indeed maximal) ideal of ℤ. -/
  -- Step 2.1: Use the fact that the ideal generated by a prime natural number is maximal in ℤ.
  have hP_max : P.IsMaximal := by
    -- Step 2.1.1: Provide the fact that 3 is a prime natural number.
    let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
    -- Step 2.1.2: Use the mathlib instance stating that `(3)` is maximal in ℤ.
    simpa [P] using (Int.ideal_span_isMaximal_of_prime (p := 3))
  -- Step 2.2: Extract that `P` is prime and proper.
  have hP_prime : P.IsPrime := hP_max.isPrime
  have hP_ne_top : (P : Ideal ℤ) ≠ ⊤ := hP_prime.ne_top

  /- Step 3: Compute the degree and leading coefficient of `f`, and deduce that it is monic and primitive. -/
  -- Step 3.1: Compute the natural degree `natDegree` of `f` (it is 6).
  have hdeg_nat : f.natDegree = 6 := by
    -- `compute_degree!` automatically computes the degree of explicit polynomials.
    unfold f
    compute_degree!
  -- Step 3.2: Compute the usual degree `degree f` (with values in `WithBot ℕ`), also equal to 6.
  have hdeg_deg : f.degree = (6 : WithBot ℕ) := by
    unfold f
    compute_degree!
  -- Step 3.3: Compute the leading coefficient of `f` and show that it equals 1.
  have hf_leading : f.leadingCoeff = 1 := by
    -- Leading coefficient is the coefficient at `natDegree`; `compute_degree!` computes it.
    simp only [f, Polynomial.leadingCoeff, hdeg_nat]
    compute_degree!
  -- Step 3.4: Deduce that `f` is monic.
  have hf_monic : f.Monic := by
    -- By definition, a polynomial is monic iff its leading coefficient is 1.
    simp [Polynomial.Monic, hf_leading]
  -- Step 3.5: A monic polynomial over a domain is primitive (its coefficients have gcd 1).
  have hf_primitive : f.IsPrimitive := hf_monic.isPrimitive
  -- Step 3.6: The polynomial has positive degree (so it is non-constant).
  have hdeg_pos : 0 < f.degree := by
    -- Using the explicit computation `degree f = 6`, the inequality is immediate.
    simp [hdeg_deg]  -- `simp` rewrites the goal to `0 < (6 : WithBot ℕ)`.

  /- Step 4: Verify Eisenstein's conditions at the ideal `P = (3)`. -/
  -- Step 4.1: The leading coefficient is not in `P` (since `P` is proper, it does not contain 1).
  have hfl : f.leadingCoeff ∉ P := by
    -- Step 4.1.1: In a proper ideal, 1 is not a member.
    have h1 : (1 : ℤ) ∉ P := (Ideal.ne_top_iff_one _).1 hP_ne_top
    -- Step 4.1.2: Use `hf_leading` to replace `leadingCoeff f` with 1.
    simpa [hf_leading] using h1

  -- Step 4.2: All coefficients of degree strictly less than `degree f` lie in `P`.
  -- This is exactly the assumption that every non-leading coefficient is divisible by 3.
  have hfP : ∀ n : ℕ, (↑n : WithBot ℕ) < f.degree → f.coeff n ∈ P := by
    -- Step 4.2.1: Introduce an arbitrary natural number `n` below the degree of `f`.
    intro n hn_lt
    -- Step 4.2.2: Rewrite the inequality using the explicit degree `degree f = 6`.
    have hn_lt6 : n < 6 := by
      -- Here `hn_lt` is `n < degree f`; with `hdeg_deg` this becomes `n < 6`.
      simpa [hdeg_deg] using hn_lt
    -- Step 4.2.3: Show that `(3 : ℤ)` divides the coefficient `f.coeff n`.
    have hdiv : (3 : ℤ) ∣ f.coeff n := by
      -- Step 4.2.3.1: Use `interval_cases` together with `hn_lt6 : n < 6`
      -- to split into the six possibilities `n = 0,1,2,3,4,5`.
      interval_cases n
      -- Step 4.2.3.2: In each case, compute the coefficient explicitly and check divisibility by 3.
      · -- Case `n = 0`
        -- Coefficient is `-120`, clearly divisible by 3.
        simp [hf_def, sub_eq_add_neg]
      · -- Case `n = 1`
        -- Coefficient is `6`, clearly divisible by 3.
        simp [hf_def, sub_eq_add_neg]
      · -- Case `n = 2`
        -- Coefficient is `6 * X.coeff 2 = 3 * (2 * X.coeff 2)`.
        have hcoeff : f.coeff 2 = 6 * X.coeff 2 := by
          simp [hf_def, sub_eq_add_neg]
        -- Since `3 ∣ 6`, we have `3 ∣ 6 * X.coeff 2`.
        have hbase : (3 : ℤ) ∣ (6 : ℤ) := by
          exact ⟨2, by norm_num⟩
        have hmul : (3 : ℤ) ∣ 6 * X.coeff 2 :=
          dvd_mul_of_dvd_left hbase _
        simpa [hcoeff] using hmul
      · -- Case `n = 3`
        -- Coefficient is `-15 + 6 * X.coeff 3 = 3 * (-5 + 2 * X.coeff 3)`.
        have hcoeff : f.coeff 3 = -15 + 6 * X.coeff 3 := by
          simp [hf_def, sub_eq_add_neg, add_comm, add_assoc]
        -- Both `-15` and `6 * X.coeff 3` are divisible by 3, hence so is their sum.
        have h1 : (3 : ℤ) ∣ (-15 : ℤ) := by
          exact ⟨-5, by norm_num⟩
        have h2base : (3 : ℤ) ∣ (6 : ℤ) := by
          exact ⟨2, by norm_num⟩
        have h2 : (3 : ℤ) ∣ 6 * X.coeff 3 :=
          dvd_mul_of_dvd_left h2base _
        have hsum : (3 : ℤ) ∣ -15 + 6 * X.coeff 3 :=
          dvd_add h1 h2
        simpa [hcoeff] using hsum
      · -- Case `n = 4`
        -- Coefficient is `6 * X.coeff 4 = 3 * (2 * X.coeff 4)`.
        have hcoeff : f.coeff 4 = 6 * X.coeff 4 := by
          simp [hf_def, sub_eq_add_neg]
        have hbase : (3 : ℤ) ∣ (6 : ℤ) := by
          exact ⟨2, by norm_num⟩
        have hmul : (3 : ℤ) ∣ 6 * X.coeff 4 :=
          dvd_mul_of_dvd_left hbase _
        simpa [hcoeff] using hmul
      · -- Case `n = 5`
        -- Coefficient is `30 + 6 * X.coeff 5 = 3 * (10 + 2 * X.coeff 5)`.
        have hcoeff : f.coeff 5 = 30 + 6 * X.coeff 5 := by
          simp [hf_def, sub_eq_add_neg, add_comm, add_assoc]
        have h1 : (3 : ℤ) ∣ (30 : ℤ) := by
          exact ⟨10, by norm_num⟩
        have h2base : (3 : ℤ) ∣ (6 : ℤ) := by
          exact ⟨2, by norm_num⟩
        have h2 : (3 : ℤ) ∣ 6 * X.coeff 5 :=
          dvd_mul_of_dvd_left h2base _
        have hsum : (3 : ℤ) ∣ 30 + 6 * X.coeff 5 :=
          dvd_add h1 h2
        simpa [hcoeff] using hsum
    -- Step 4.2.4: Convert the divisibility statement into membership in the ideal `P = (3)`.
    have hx : f.coeff n ∈ (Ideal.span ({(3 : ℤ)} : Set ℤ)) := by
      -- Using `Ideal.mem_span_singleton`: `x ∈ (3)` iff `3 ∣ x`.
      simpa [Ideal.mem_span_singleton] using hdiv
    -- Step 4.2.5: Replace `Ideal.span {3}` with `P` to finish.
    simpa [P] using hx

  -- Step 4.3: The constant coefficient is not in `P^2`, i.e., it is not divisible by `3^2 = 9`.
  -- Step 4.3.1: First compute the constant coefficient `f.coeff 0`.
  have hcoeff0 : f.coeff 0 = (-120 : ℤ) := by
    -- Only the constant term `-120` contributes to the coefficient of degree 0.
    simp [hf_def, sub_eq_add_neg]
  -- Step 4.3.2: Show that this constant term is not in `P^2`.
  have h0 : f.coeff 0 ∉ P ^ 2 := by
    -- Suppose, for a contradiction, that `f.coeff 0 ∈ P^2`.
    refine fun h => ?_
    -- Step 4.3.2.1: First rewrite `P^2` as the principal ideal generated by `3^2`.
    have hP2 :
        P ^ 2 = Ideal.span ({(3 : ℤ) ^ 2} : Set ℤ) := by
      -- Here we use `P = span {3}` and `span_singleton_pow`.
      simpa [P] using (Ideal.span_singleton_pow (s := (3 : ℤ)) (n := 2))
    -- Using this equality, view `h` as a membership in `span {3^2}`.
    have h' : f.coeff 0 ∈ Ideal.span ({(3 : ℤ) ^ 2} : Set ℤ) := by
      simpa [hP2] using h
    -- Step 4.3.2.2: Membership in `span {3^2}` is equivalent to divisibility by `3^2`.
    have hdiv : ((3 : ℤ) ^ 2) ∣ f.coeff 0 := by
      -- `Ideal.mem_span_singleton` gives the divisibility interpretation.
      simpa [Ideal.mem_span_singleton] using h'
    -- Step 4.3.2.2: But `9` does not divide `-120`, a contradiction.
    simp [hcoeff0, pow_two] at hdiv

  /- Step 5: Apply the Eisenstein irreducibility lemma and translate back to the original polynomial. -/
  -- Step 5.1: Use `Polynomial.irreducible_of_eisenstein_criterion` with prime ideal `P = (3)`.
  have hirr_f : Irreducible f :=
    Polynomial.irreducible_of_eisenstein_criterion
      (f := f) (P := P) hP_prime hfl hfP hdeg_pos h0 hf_primitive
  -- Step 5.2: Rewrite `f` back to the original expression using `hf_def`.
  simpa [hf_def] using hirr_f
