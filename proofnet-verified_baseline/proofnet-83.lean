import Mathlib

open Fintype Set Real Ideal Polynomial
open scoped BigOperators



/-Informal Statement

Show that any subgroup of order $p^{n-1}$ in a group $G$ of order $p^n$ is normal in $G$.
-/

/-Informal Proof

Proof: First we prove the following lemma.

\textbf{Lemma:} If $G$ is a finite $p$-group with $|G|>1$, then $Z(G)$, the center of $G$, has more than one element; that is, if $|G|=p^k$ with $k\geq 1$, then $|Z(G)|>1$.

\textit{Proof of the lemma:} Consider the class equation
$$
|G|=|Z(G)|+\sum_{a \notin Z(G)}[G: C(a)],
$$
where $C(a)$ denotes the centralizer of $a$ in $G$. If $G=Z(G)$, then the lemma is immediate. Suppose $Z(G)$ is a proper subset of $G$ and consider an element $a\in G$ such that $a\notin Z(G)$. Then $C(a)$ is a proper subgroup of $G$. Since $C(a)$ is a subgroup of a $p$-group, $[G:C(a)]$ is divisible by $p$ for all $a\notin Z(G)$. This implies that $p$ divides $|G|=|Z(G)|+\sum_{a\notin Z(G)} [G:C(a)]$.

Since $p$ also divides $|G|$, it follows that $p$ divides $|Z(G)|$. Hence, $|Z(G)|>1$. $\Box$

This proves our \textbf{lemma}.

We will prove the result by induction on $n$.
If $n=1$, the $G$ is a cyclic group of prime order and hence every subgroup of $G$ is normal in $G$. Thus, the result is true for $n=1$.
Suppose the result is true for all groups of order $p^m$, where $1 \leq m<n$.
Let $H$ be a subgroup of order $p^{n-1}$.
Consider $N(H)=\{g \in H: g H=H g\}$.
If $H \neq N(H)$, then $|N(H)|>p^{n-1}$. Thus, $|N(H)|=p^n$ and $N(H)=G$.
In this case $H$ is normal in $G$.
Let $H=N(H)$. Then $Z(G)$, the center of $G$, is a subset of $H$ and $Z(G) \neq$ $\{e\}$.
By Cauchy's theorem and the above Claim, there exists $a \in Z(G)$ such that $o(a)=p$.
Let $K=\langle a\rangle$, a cyclic group generated by $a$.
Then $K$ is a normal subgroup of $G$ of order $p$. Now, $|H / K|=p^{n-2}$ and $|G / K|=p^{n-1}$.
Thus, by induction hypothesis, $H / K$ is a normal subgroup of $G / K$.
-/

theorem Herstein_exercise_2_11_22 {p : ℕ} {n : ℕ} {G : Type*} [Fintype G]
  [Group G] (hp : Nat.Prime p) (hG : card G = p ^ n) {K : Subgroup G}
  [Fintype K] (hK : card K = p ^ (n-1)) :
  K.Normal := by
  classical
  -- Step 1: Turn the primality assumption into an instance so that `p`-group lemmas apply.
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  -- Step 2: Split on `n` so that we can treat the base case and the inductive step separately.
  cases' n with m
  · -- Step 2.1: Handle the base case `n = 0`, where both `G` and `K` have exactly one element.
    -- Step 2.1.1: Record the exact cardinalities of `G` and `K` in this situation.
    have hG_card : Fintype.card G = 1 := by simpa [Nat.pow_zero] using hG
    have hK_card : Fintype.card K = 1 := by simpa [Nat.pow_zero] using hK
    -- Step 2.1.2: Apply `card_mul_index` to deduce that the index of `K` equals `1`.
    have hIndexEq : 1 * K.index = 1 := by
      simpa [hK_card, hG_card] using K.card_mul_index
    have hIndex : K.index = 1 := by simpa using hIndexEq
    -- Step 2.1.4: Conclude that `K = ⊤`, whence `K` is normal.
    have hTop : K = (⊤ : Subgroup G) := Subgroup.index_eq_one.mp hIndex
    have hNormalTop : (⊤ : Subgroup G).Normal := inferInstance
    simp [hTop]
  · -- Step 2.2: Handle the case `n = m + 1`, where `K` has index `p` in the `p`-group `G`.
    -- Step 2.2.1: Simplify the cardinality assumptions under the identification `n = m + 1`.
    have hG_card : Fintype.card G = p ^ Nat.succ m := by simpa using hG
    have hK_card : Fintype.card K = p ^ m := by simpa using hK
    -- Step 2.2.2: Use `card_mul_index` to compute that the index of `K` equals `p`.
    have hIndexMul : (p : ℕ) ^ m * K.index = (p : ℕ) ^ m * p := by
      have hEq : Fintype.card K * K.index = Fintype.card G := by
        simpa using K.card_mul_index
      simpa [hK_card, hG_card, Nat.pow_succ, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc]
        using hEq
    have hPowPos : 0 < (p : ℕ) ^ m := by
      simpa using (Nat.pow_pos (Nat.Prime.pos hp : 0 < (p : ℕ)) (n := m))
    have hIndex : K.index = p :=
      Nat.eq_of_mul_eq_mul_left hPowPos hIndexMul
    -- Step 2.2.3: Show that `K` is a proper subgroup so the normalizer condition applies.
    have hp_ne_one : (p : ℕ) ≠ 1 := Nat.Prime.ne_one hp
    have hK_ne_top : K ≠ (⊤ : Subgroup G) := by
      intro hTop
      have : K.index = 1 := Subgroup.index_eq_one.mpr hTop
      exact hp_ne_one (by simpa [hIndex] using this)
    have hK_lt_top : K < (⊤ : Subgroup G) := lt_of_le_of_ne le_top hK_ne_top
    -- Step 2.2.4: Exhibit that `G` is a nilpotent `p`-group, so the normalizer condition holds.
    have hG_nat : Nat.card G = p ^ Nat.succ m := by
      simp [Nat.card_eq_fintype_card, hG_card]
    have hPgroup : IsPGroup p G := IsPGroup.of_card (G:=G) (p:=p) (n:=Nat.succ m) hG_nat
    have hNilpotent : Group.IsNilpotent G := IsPGroup.isNilpotent (G:=G) (p:=p) hPgroup
    have hNormalizerCondition : NormalizerCondition G := by
      haveI : Group.IsNilpotent G := hNilpotent
      exact normalizerCondition_of_isNilpotent (G:=G)
    have hLtNormalizer : K < K.normalizer := hNormalizerCondition K hK_lt_top
    -- Step 2.2.5: Control the relative index of `K` inside its normalizer.
    have hRelIndex_dvd : K.relIndex K.normalizer ∣ K.index :=
      Subgroup.relIndex_dvd_index_of_le (H:=K) (K:=K.normalizer) K.le_normalizer
    have hRelIndex_ne_one : K.relIndex K.normalizer ≠ 1 := by
      intro hEq
      have h_le : K.normalizer ≤ K :=
        (Subgroup.relIndex_eq_one (H:=K) (K:=K.normalizer)).mp hEq
      have h_eq : K.normalizer = K := le_antisymm h_le K.le_normalizer
      exact (ne_of_lt hLtNormalizer) h_eq.symm
    have hRelIndex : K.relIndex K.normalizer = p := by
      obtain hEq | hEq :=
          (Nat.dvd_prime hp).mp (by simpa [hIndex] using hRelIndex_dvd)
      · exact (hRelIndex_ne_one hEq).elim
      · exact hEq
    -- Step 2.2.6: Use the relative index to force the normalizer itself to have index `1`.
    have hRelIndexMul :
        K.relIndex K.normalizer * (K.normalizer).index = K.index :=
      Subgroup.relIndex_mul_index K.le_normalizer
    have hNormalizerIndex : (K.normalizer).index = 1 := by
      have hEq : (p : ℕ) * (K.normalizer).index = (p : ℕ) * 1 := by
        simpa [hRelIndex, hIndex, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_one]
          using hRelIndexMul
      have hp_pos : 0 < (p : ℕ) := Nat.Prime.pos hp
      exact Nat.eq_of_mul_eq_mul_left hp_pos hEq
    -- Step 2.2.7: A subgroup whose normalizer has index `1` is normal, completing the proof.
    have hNormalizer_top : K.normalizer = (⊤ : Subgroup G) :=
      Subgroup.index_eq_one.mp hNormalizerIndex
    have hNormal : K.Normal :=
      (Subgroup.normalizer_eq_top_iff (H:=K)).1 hNormalizer_top
    exact hNormal
