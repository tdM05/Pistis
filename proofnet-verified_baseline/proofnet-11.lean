import Mathlib

open Function Fintype Subgroup Ideal Polynomial Submodule Zsqrtd
open scoped BigOperators



/-Informal Statement

Prove that $x^3 + 6x + 12$ is irreducible in $\mathbb{Q}$.
-/

/-Informal Proof

Apply Eisenstein's criterion with $p=3$.
-/

theorem Artin_exercise_11_4_1b :
  Irreducible (12 + 6 * X + X ^ 3 : Polynomial ℚ) := by
  -- Step 1: Switch to classical logic so that divisibility and case splits on natural numbers are decidable.
  classical
  -- Step 2: Introduce the integer polynomial whose rational image is the target cubic.
  set gℤ : Polynomial ℤ :=
      C (1 : ℤ) * X ^ 3 + C 0 * X ^ 2 + C 6 * X + C 12 with hgℤ
  -- Step 2.1: Compute the structural data (monicity and degree) of the integer polynomial.
  have hNatDegree : gℤ.natDegree = 3 := by
    -- Step 2.1.1: Apply the dedicated cubic lemma with coefficients (1,0,6,12).
    simpa [hgℤ] using
      (Polynomial.natDegree_cubic (R := ℤ) (a := (1 : ℤ)) (b := 0) (c := 6) (d := 12)
        (by decide : (1 : ℤ) ≠ 0))
  have hMonic : gℤ.Monic := by
    -- Step 2.1.2: Read off the leading coefficient via the cubic helper lemma.
    have hLead :
        gℤ.leadingCoeff = (1 : ℤ) := by
          simpa [hgℤ] using
            (Polynomial.leadingCoeff_cubic (R := ℤ) (a := (1 : ℤ)) (b := 0) (c := 6)
              (d := 12) (by decide : (1 : ℤ) ≠ 0))
    -- Step 2.1.3: Turn the leading-coefficient statement into monicity.
    exact hLead
  -- Step 2.2: Record the explicit coefficients that will be used to verify Eisenstein's hypotheses.
  have hCoeff0 : gℤ.coeff 0 = (12 : ℤ) := by
    -- Step 2.2.1: Simplify the constant term of the cubic.
    simp [hgℤ, coeff_X_pow, coeff_X]
  have hCoeff1 : gℤ.coeff 1 = (6 : ℤ) := by
    -- Step 2.2.2: Simplify the linear coefficient.
    simp [hgℤ, coeff_X_pow, coeff_X]
  have hCoeff2 : gℤ.coeff 2 = (0 : ℤ) := by
    -- Step 2.2.3: Note that the quadratic coefficient vanishes.
    simp [hgℤ, coeff_X_pow, coeff_X]
  -- Step 3: Fix the prime ideal generated by 3, which will be used in Eisenstein's criterion.
  set P : Ideal ℤ := Ideal.span ({(3 : ℤ)} : Set ℤ) with hPDef
  -- Step 3.1: Establish that the ideal is proper and prime.
  have hPneTop : P ≠ ⊤ := by
    -- Step 3.1.1: An ideal generated by a non-unit integer (here, 3) is not the whole ring.
    have h3notUnit : ¬ IsUnit (3 : ℤ) := by decide
    -- Step 3.1.2: Translate the non-unit statement into the ideal-theoretic formulation.
    simpa [P, Ideal.span_singleton_eq_top] using h3notUnit
  have hPPrime : P.IsPrime := by
    -- Step 3.1.3: 3 is a prime number in ℤ, hence the principal ideal it generates is prime.
    have hPrimeInt :
        Prime (3 : ℤ) := by
          have hNat : Nat.Prime 3 := by decide
          have hNatAbs : Nat.Prime (Int.natAbs (3 : ℤ)) := by simpa using hNat
          exact (Int.prime_iff_natAbs_prime).2 hNatAbs
    -- Step 3.1.4: Transfer primality of the element to primality of the ideal.
    simpa [P] using
      (Ideal.span_singleton_prime (by decide : (3 : ℤ) ≠ 0)).2 hPrimeInt
  -- Step 3.2: Verify that every lower-degree coefficient lies in the ideal generated by 3.
  have hMem :
      ∀ ⦃n : ℕ⦄, n < gℤ.natDegree → gℤ.coeff n ∈ P := by
    -- Step 3.2.1: Convert the upper bound on the index into a concrete inequality `n < 3`.
    intro n hn
    have hnlt3 : n < 3 := by simpa [hNatDegree] using hn
    -- Step 3.2.2: Perform a finite case split on the possible values of `n`.
    revert hnlt3
    -- Step 3.2.3: Handle the constant term (n = 0).
    cases n with
    | zero =>
        intro _
        -- Step 3.2.3.1: Show 3 divides the constant coefficient 12.
        have hDiv : (3 : ℤ) ∣ 12 := ⟨4, by decide⟩
        -- Step 3.2.3.2: Convert back to membership in the generating ideal.
        simpa [hCoeff0, P] using Ideal.mem_span_singleton.mpr hDiv
    | succ n =>
        -- Step 3.2.4: Handle the linear term (n = 1).
        cases n with
        | zero =>
            intro _
            -- Step 3.2.4.1: Verify that 3 divides 6.
            have hDiv : (3 : ℤ) ∣ 6 := ⟨2, by decide⟩
            -- Step 3.2.4.2: Pull the divisibility information back to the ideal membership.
            simpa [hCoeff1, P] using Ideal.mem_span_singleton.mpr hDiv
        | succ n =>
            -- Step 3.2.5: Handle the quadratic term (n = 2).
            cases n with
            | zero =>
                intro _
                -- Step 3.2.5.1: The vanishing coefficient obviously belongs to every ideal.
                simp [hCoeff2]
            | succ n =>
                -- Step 3.2.6: Any larger index contradicts the assumption `n < 3`.
                intro hnlt3
                have hge :
                    3 ≤ Nat.succ (Nat.succ (Nat.succ n)) :=
                  Nat.succ_le_succ <|
                    Nat.succ_le_succ <|
                      Nat.succ_le_succ (Nat.zero_le _)
                exact (Nat.not_lt_of_ge hge hnlt3).elim
  -- Step 3.3: Check that the constant coefficient is not in the square of the ideal (i.e., 9 ∤ 12).
  have hCoeff0Not :
      gℤ.coeff 0 ∉ P ^ 2 := by
    -- Step 3.3.1: Observe that 9 does not divide 12.
    have hNoDiv : ¬ ((3 : ℤ) ^ 2 ∣ (12 : ℤ)) := by decide
    -- Step 3.3.2: Rewrite ideal-theoretic membership in terms of this divisibility.
    intro hMemPow
    have hDiv :
        (3 : ℤ) ^ 2 ∣ gℤ.coeff 0 := by
      have :
          gℤ.coeff 0 ∈ Ideal.span ({((3 : ℤ) ^ 2)} : Set ℤ) := by
        simpa [P, pow_two, hCoeff0, Ideal.span_singleton_mul_span_singleton,
          mul_comm, mul_left_comm, mul_assoc] using hMemPow
      exact Ideal.mem_span_singleton.mp this
    simp [hCoeff0] at hDiv
  -- Step 3.4: Confirm that the leading coefficient lies outside the ideal (1 is not divisible by 3).
  have hLeadNotMem :
      gℤ.leadingCoeff ∉ P := by
    -- Step 3.4.1: Establish that 3 does not divide 1.
    have hNoDiv : ¬ (3 : ℤ) ∣ (1 : ℤ) := by decide
    -- Step 3.4.2: Translate the divisibility failure back to the ideal membership condition.
    intro hMem
    have hDiv : (3 : ℤ) ∣ gℤ.leadingCoeff :=
      Ideal.mem_span_singleton.mp hMem
    simp [hMonic.leadingCoeff] at hDiv
  -- Step 4: Assemble the Eisenstein witness using the data collected so far.
  have hEisenstein : gℤ.IsEisensteinAt P := by
    -- Step 4.1: Apply the monic Eisenstein constructor with the membership and non-membership facts.
    exact
      Polynomial.Monic.isEisensteinAt_of_mem_of_notMem (f := gℤ) hMonic hPneTop
        (fun {n} hn => hMem hn) hCoeff0Not
  -- Step 4.2: Record that the polynomial is primitive (a monic integer polynomial is primitive).
  have hPrimitive : gℤ.IsPrimitive := hMonic.isPrimitive
  -- Step 4.3: Eisenstein delivers irreducibility over ℤ together with the degree positivity.
  have hIrredZ :
      Irreducible gℤ :=
    Polynomial.IsEisensteinAt.irreducible hEisenstein hPPrime hPrimitive
      (by -- Step 4.3.1: Convert `natDegree = 3` into the required positivity hypothesis.
        simp [hNatDegree])
  -- Step 5: Transport irreducibility to ℚ via Gauss's lemma.
  have hIrredQ :
      Irreducible (gℤ.map (Int.castRingHom ℚ)) :=
    (Polynomial.IsPrimitive.Int.irreducible_iff_irreducible_map_cast hPrimitive).1 hIrredZ
  -- Step 5.1: Evaluate the map to rewrite it as the original polynomial over ℚ.
  have hMap :
      gℤ.map (Int.castRingHom ℚ) =
        (12 + 6 * X + X ^ 3 : Polynomial ℚ) := by
    -- Step 5.1.1: Simplify the ring homomorphism action coefficient-wise.
    simp [hgℤ, add_comm, add_assoc]
  -- Step 5.2: Conclude irreducibility of the initial polynomial.
  simpa [hMap] using hIrredQ
