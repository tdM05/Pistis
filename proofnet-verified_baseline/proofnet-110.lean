import Mathlib

open Filter Set TopologicalSpace
open scoped Topology

def lower_limit_topology (X : Type) [Preorder X] :=
  generateFrom {S : Set X | ∃ a b, a < b ∧ S = Ico a b}

/-Informal Statement

Show that the collection $\{(a,b) \mid a < b, a \text{ and } b \text{ rational}\}$ is a basis that generates a topology different from the lower limit topology on $\mathbb{R}$.
-/

/-Informal Proof

(b) $\mathcal{C}$ is a basis for a topology on $\mathbb{R}$ since the union of its elements is $\mathbb{R}$ and the intersection of two elements of $\mathcal{C}$ is either empty or another element of $\mathcal{C}$. Now consider $[r, s)$ where $r$ is any irrational number and $s$ is any real number greater than $r$. Then $[r, s)$ is a basis element for the topology of $\mathbb{R}_{\ell}$, but $[r, s)$ is not a union of elements of $\mathcal{C}$. Indeed, suppose that $[r, s)=\cup_\alpha\left[a_\alpha, b_\alpha\right)$ for rationals $a_\alpha, b_\alpha$. Then $r \in\left[a_\alpha, b_\alpha\right)$ for some $\alpha$. Since $r$ is irrational we must have $a_\alpha<r$, but then $a_\alpha \notin[r, s)$, a contradiction. It follows that the topology generated by $\mathcal{C}$ is strictly coarser than the lower limit topology on $\mathbb{R}$.
-/

theorem Munkres_exercise_13_8b (T : Set (Set ℝ))
  (hT : T = {S : Set ℝ | ∃ a b : ℚ, a < b ∧ S = Ioo ↑a ↑b}) :
  IsTopologicalBasis T ∧
  generateFrom T ≠
  lower_limit_topology ℝ := by
  classical
  -- Step 1: Extract the concrete membership description of `T` that involves rational endpoints.
  have h_mem : ∀ {U : Set ℝ}, U ∈ T ↔ ∃ a b : ℚ, a < b ∧ U = Ioo (a : ℝ) (b : ℝ) := by
    -- Step 1.1: Use the provided identity `hT` to rewrite membership in `T`.
    intro U
    simp [hT]
  -- Step 2: Prove that `T` forms a topological basis for the usual topology on `ℝ`.
  have h_basis : IsTopologicalBasis T := by
    -- Step 2.1: Apply the neighbourhood-based criterion for topological bases.
    refine isTopologicalBasis_of_isOpen_of_nhds ?h_open ?h_nhds
    -- Step 2.1.1: Show that every set in `T` is open in the standard topology of `ℝ`.
    · intro U hU
      -- Step 2.1.1.1: Specialise `h_mem` to obtain rational endpoints for `U` and use `isOpen_Ioo`.
      rcases (h_mem).1 hU with ⟨a, b, hab, rfl⟩
      exact isOpen_Ioo
    -- Step 2.1.2: For any open neighbourhood `U` of `x`, find a rational interval from `T` inside `U`.
    · intro x U hxU hUopen
      -- Step 2.1.2.1: From openness, take a metric ball around `x` contained in `U`.
      rcases Metric.isOpen_iff.mp hUopen x hxU with ⟨ε, ε_pos, h_ball_subset⟩
      -- Step 2.1.2.2: Work with the smaller radius `δ = ε / 2` to simplify later inequalities.
      set δ := ε / 2 with hδdef
      have δ_pos : 0 < δ := by
        -- Step 2.1.2.2.1: Positivity follows from `ε_pos`.
        simpa [δ, hδdef] using half_pos ε_pos
      have δ_lt_ε : δ < ε := by
        -- Step 2.1.2.2.2: Halving a positive real makes it strictly smaller.
        simpa [δ, hδdef] using half_lt_self ε_pos
      -- Step 2.1.2.3: Use density of `ℚ` to choose rational endpoints hugging `x`.
      have h_left : x - δ < x := by
        -- Step 2.1.2.3.1: Subtracting a positive number strictly decreases the real number.
        simpa [δ, hδdef] using sub_lt_self x δ_pos
      obtain ⟨a, ha_left, ha_right⟩ := exists_rat_btwn h_left
      have h_right : x < x + δ := by
        -- Step 2.1.2.3.2: Adding a positive number strictly increases the real number.
        simpa [δ, hδdef] using lt_add_of_pos_right x δ_pos
      obtain ⟨b, hb_left, hb_right⟩ := exists_rat_btwn h_right
      -- Step 2.1.2.4: Collect the interval `Ioo (a : ℝ) (b : ℝ)` and verify all required properties.
      refine ⟨Ioo (a : ℝ) (b : ℝ), ?_, ?_, ?_⟩
      -- Step 2.1.2.4.1: Record membership of the interval in `T`.
      · have hab_real : (a : ℝ) < (b : ℝ) := lt_trans ha_right hb_left
        have hab : a < b := by
          -- Step 2.1.2.4.1.1: Coercions `ℚ → ℝ` preserve strict inequalities.
          exact_mod_cast hab_real
        exact (h_mem).2 ⟨a, b, hab, rfl⟩
      -- Step 2.1.2.4.2: Confirm that `x` is indeed inside the rational interval.
      · exact ⟨ha_right, hb_left⟩
      -- Step 2.1.2.4.3: Show the interval stays inside the bounding metric ball, hence inside `U`.
      · have h_sub₁ : Ioo (a : ℝ) (b : ℝ) ⊆ Ioo (x - δ) (x + δ) := by
          -- Step 2.1.2.4.3.1: The left boundary is captured by transitivity of inequalities.
          intro y hy
          refine ⟨lt_trans ha_left hy.1, lt_trans hy.2 hb_right⟩
        have h_sub₂ : Ioo (x - δ) (x + δ) ⊆ Metric.ball x ε := by
          -- Step 2.1.2.4.3.2: Translate interval containment into control of the absolute difference.
          intro y hy
          have hy_lower : -δ < y - x := by
            -- Step 2.1.2.4.3.2.1: Subtract `x` from the inequality `x - δ < y`.
            have := sub_lt_sub_right hy.1 x
            simpa [δ, hδdef, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using this
          have hy_upper : y - x < δ := by
            -- Step 2.1.2.4.3.2.2: Subtract `x` from the inequality `y < x + δ`.
            have := sub_lt_sub_right hy.2 x
            simpa [δ, hδdef, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using this
          have hy_abs_lt : |y - x| < δ := by
            -- Step 2.1.2.4.3.2.3: Combine both sides via `abs_lt`.
            exact abs_lt.mpr ⟨hy_lower, hy_upper⟩
          have hy_abs_lt' : |y - x| < ε := lt_trans hy_abs_lt δ_lt_ε
          have hy_dist_lt : dist y x < ε := by
            -- Step 2.1.2.4.3.2.4: Bridge from absolute value to metric distance.
            simpa [Real.dist_eq] using hy_abs_lt'
          -- Step 2.1.2.4.3.2.5: Conclude membership in the required metric ball.
          simpa [Metric.mem_ball] using hy_dist_lt
        -- Step 2.1.2.4.3.3: Compose both subsets and finish.
        exact h_sub₁.trans (h_sub₂.trans h_ball_subset)
  -- Step 3: Confirm the specific half-open interval `[0,1)` is open in the lower-limit topology.
  have h_lower_open : (lower_limit_topology ℝ).IsOpen (Ico (0 : ℝ) 1) := by
    -- Step 3.1: `[0,1)` is literally one of the generating sets.
    have : Ico (0 : ℝ) 1 ∈ {S : Set ℝ | ∃ a b, a < b ∧ S = Ico a b} := by
      -- Step 3.1.1: Witness the generators using `a = 0`, `b = 1`.
      exact ⟨0, 1, by norm_num, rfl⟩
    -- Step 3.2: Apply the generic lemma converting membership in the generating family to openness.
    simpa [lower_limit_topology] using (TopologicalSpace.isOpen_generateFrom_of_mem this)
  -- Step 4: Show that `[0,1)` is not open in the standard topology (hence not in `generateFrom T`).
  have h_not_open_std : ¬ IsOpen (Ico (0 : ℝ) 1) := by
    -- Step 4.1: Argue by contradiction via the metric characterisation of openness.
    intro h_open
    -- Step 4.1.1: Note that `0` belongs to the set, so an open neighbourhood must exist at `0`.
    have h_zero_mem : (0 : ℝ) ∈ Ico (0 : ℝ) 1 := by
      -- Step 4.1.1.1: The defining inequalities are straightforward.
      exact ⟨le_rfl, by norm_num⟩
    rcases Metric.isOpen_iff.mp h_open 0 h_zero_mem with ⟨ε, ε_pos, h_ball_subset⟩
    -- Step 4.1.2: Consider the left-shifted point `y = -ε / 2`, which still lies in the ball.
    set y := -(ε / 2) with hydef
    have hy_mem_ball : y ∈ Metric.ball (0 : ℝ) ε := by
      -- Step 4.1.2.1: Compute the distance from `y` to `0` exactly.
      have hy_dist₀ : dist y (0 : ℝ) = |ε| / 2 := by
        -- Step 4.1.2.1.0: Expand the distance via absolute values.
        calc
          dist y (0 : ℝ) = |y| := by simp
          _ = |-(ε / 2)| := by simp [hydef]
          _ = |ε / 2| := by simp
          _ = |ε| / 2 := by
            simp [abs_div]
      have hy_dist : dist y (0 : ℝ) = ε / 2 := by
        simpa [abs_of_nonneg (le_of_lt ε_pos)] using hy_dist₀
      -- Step 4.1.2.1.1: Convert the equality into the desired inequality using `ε/2 < ε`.
      have h_half_lt : ε / 2 < ε := half_lt_self ε_pos
      have : dist y (0 : ℝ) < ε := by simpa [hy_dist] using h_half_lt
      -- Step 4.1.2.1.2: Translate to membership in the metric ball.
      simpa [Metric.mem_ball] using this
    have hy_not_mem : y ∉ Ico (0 : ℝ) 1 := by
      -- Step 4.1.2.2: The constructed point lies strictly to the left of `0`.
      have hy_lt : y < 0 := by
        have : ε / 2 > 0 := half_pos ε_pos
        simpa [hydef] using neg_lt_zero.mpr this
      intro hy
      exact hy_lt.not_ge hy.1
    -- Step 4.1.3: Contradiction—`y` simultaneously lies inside the ball and outside the set.
    exact hy_not_mem (h_ball_subset hy_mem_ball)
  -- Step 5: Translate `h_not_open_std` to the topology generated by `T` and finish the argument.
  have h_not_open_generate : ¬ (generateFrom T).IsOpen (Ico (0 : ℝ) 1) := by
    -- Step 5.1: Use the identity supplied by the basis to switch viewpoints.
    simpa [h_basis.eq_generateFrom] using h_not_open_std
  -- Step 6: Combine the open set in the lower-limit topology with the non-openness in `generateFrom T`.
  refine ⟨h_basis, ?_⟩
  -- Step 6.1: Prove the claimed inequality of topologies by contradiction on an open set.
  intro h_eq
  have h_open_generate : (generateFrom T).IsOpen (Ico (0 : ℝ) 1) := by
    -- Step 6.1.1: Transport the openness from the lower-limit topology via the supposed equality.
    simpa [h_eq] using h_lower_open
  -- Step 6.1.2: Reach the contradiction using `h_not_open_generate`.
  exact h_not_open_generate h_open_generate

/-
## Formalization Note

The use of `IsTopologicalBasis T` is slightly stronger than what the informal statement asks.
Mathlib's `IsTopologicalBasis` includes the condition `eq_generateFrom : ‹TopologicalSpace α› =
generateFrom T`, which (since ℝ carries the standard Euclidean topology by default) additionally
asserts that T generates the Euclidean topology — a claim not present in the informal statement.

The informal statement only asks:
  (1) T satisfies the basis axioms (covering + intersection refinement), and
  (2) the topology generated by T differs from the lower limit topology.

To faithfully match the informal statement, one could instead assert the two basis axioms directly
(e.g., via `IsTopologicalBasis.isOpen` conditions or raw set-theoretic predicates) without tying T
to any ambient topology instance. However, since the extra claim happens to be true (rational open
intervals do generate the Euclidean topology on ℝ), the Lean statement logically implies the
informal one — it is strictly stronger but not incorrect.

## Corrected formalization below (as `Munkres_exercise_13_8b_corrected`)
-/
theorem Munkres_exercise_13_8b_corrected (T : Set (Set ℝ))
  (hT : T = {S : Set ℝ | ∃ a b : ℚ, a < b ∧ S = Ioo ↑a ↑b}) :
  (∀ x : ℝ, ∃ S ∈ T, x ∈ S) ∧
  (∀ S₁ ∈ T, ∀ S₂ ∈ T, ∀ x ∈ S₁ ∩ S₂, ∃ S₃ ∈ T, x ∈ S₃ ∧ S₃ ⊆ S₁ ∩ S₂) ∧
  generateFrom T ≠ lower_limit_topology ℝ := by
  classical
  -- Step 1: Extract concrete membership characterization of T.
  have h_mem : ∀ {U : Set ℝ}, U ∈ T ↔ ∃ a b : ℚ, a < b ∧ U = Ioo (a : ℝ) (b : ℝ) := by
    intro U
    simp [hT]
  refine ⟨?_, ?_, ?_⟩
  -- Step 2: Prove the covering axiom — every real is contained in some element of T.
  · intro x
    -- Step 2.1: Use density of ℚ in ℝ to find a rational below x.
    obtain ⟨a, _, ha2⟩ := exists_rat_btwn (sub_lt_self x (zero_lt_one : (0 : ℝ) < 1))
    -- Step 2.2: Use density of ℚ in ℝ to find a rational above x.
    obtain ⟨b, hb1, _⟩ := exists_rat_btwn (lt_add_of_pos_right x (zero_lt_one : (0 : ℝ) < 1))
    -- Step 2.3: Establish a < b by transitivity through x (with cast from ℝ to ℚ).
    have hab : a < b := by exact_mod_cast lt_trans ha2 hb1
    -- Step 2.4: Exhibit the interval (a, b) as the required set in T containing x.
    exact ⟨Ioo (↑a) (↑b), h_mem.2 ⟨a, b, hab, rfl⟩, ⟨ha2, hb1⟩⟩
  -- Step 3: Prove the intersection refinement axiom.
  · intro S₁ hS₁ S₂ hS₂ x hx
    -- Step 3.1: Decompose S₁ and S₂ into open intervals with rational endpoints.
    rcases h_mem.1 hS₁ with ⟨a₁, b₁, _, rfl⟩
    rcases h_mem.1 hS₂ with ⟨a₂, b₂, _, rfl⟩
    -- Step 3.2: From x ∈ (a₁,b₁) ∩ (a₂,b₂), deduce max(a₁,a₂) < x < min(b₁,b₂).
    have hlb : max (↑a₁ : ℝ) (↑a₂) < x := max_lt hx.1.1 hx.2.1
    have hub : x < min (↑b₁ : ℝ) (↑b₂) := lt_min hx.1.2 hx.2.2
    -- Step 3.3: Use density to find rational c with max(a₁,a₂) < c < x.
    obtain ⟨c, hc1, hc2⟩ := exists_rat_btwn hlb
    -- Step 3.4: Use density to find rational d with x < d < min(b₁,b₂).
    obtain ⟨d, hd1, hd2⟩ := exists_rat_btwn hub
    -- Step 3.5: Establish c < d by transitivity through x.
    have hcd : c < d := by exact_mod_cast lt_trans hc2 hd1
    -- Step 3.6: Exhibit (c, d) as the witness S₃.
    refine ⟨Ioo (↑c) (↑d), ?_, ?_, ?_⟩
    -- Step 3.6.1: Show (c, d) ∈ T.
    · exact h_mem.2 ⟨c, d, hcd, rfl⟩
    -- Step 3.6.2: Show x ∈ (c, d).
    · exact ⟨hc2, hd1⟩
    -- Step 3.6.3: Show (c, d) ⊆ (a₁, b₁) ∩ (a₂, b₂).
    · intro y hy
      -- Step 3.6.3.1: For y ∈ (c, d), show y ∈ (a₁, b₁) using the chain a₁ ≤ max < c < y < d < min ≤ b₁.
      -- Step 3.6.3.2: Similarly show y ∈ (a₂, b₂).
      exact ⟨⟨lt_trans (lt_of_le_of_lt (le_max_left _ _) hc1) hy.1,
              lt_trans hy.2 (lt_of_lt_of_le hd2 (min_le_left _ _))⟩,
             ⟨lt_trans (lt_of_le_of_lt (le_max_right _ _) hc1) hy.1,
              lt_trans hy.2 (lt_of_lt_of_le hd2 (min_le_right _ _))⟩⟩
  -- Step 4: Prove generateFrom T ≠ lower_limit_topology ℝ.
  -- Step 4.1: This follows directly from the original theorem which establishes the full result.
  · exact (Munkres_exercise_13_8b T hT).2
