import Mathlib

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators



/-Informal Statement

An ideal $N$ is called nilpotent if $N^{n}$ is the zero ideal for some $n \geq 1$. Prove that the ideal $p \mathbb{Z} / p^{m} \mathbb{Z}$ is a nilpotent ideal in the ring $\mathbb{Z} / p^{m} \mathbb{Z}$.
-/

/-Informal Proof

First we prove a lemma.
Lemma: Let $R$ be a ring, and let $I_1, I_2, J \subseteq R$ be ideals such that $J \subseteq I_1, I_2$. Then $\left(I_1 / J\right)\left(I_2 / J\right)=I_1 I_2 / J$.
Proof: ( $\subseteq$ ) Let
$$
\alpha=\sum\left(x_i+J\right)\left(y_i+J\right) \in\left(I_1 / J\right)\left(I_2 / J\right) .
$$
Then
$$
\alpha=\sum\left(x_i y_i+J\right)=\left(\sum x_i y_i\right)+J \in\left(I_1 I_2\right) / J .
$$
Now let $\alpha=\left(\sum x_i y_i\right)+J \in\left(I_1 I_2\right) / J$. Then
$$
\alpha=\sum\left(x_i+J\right)\left(y_i+J\right) \in\left(I_1 / J\right)\left(I_2 / J\right) .
$$
From this lemma and the lemma to Exercise 7.3.36, it follows by an easy induction that
$$
\left(p \mathbb{Z} / p^m \mathbb{Z}\right)^m=(p \mathbb{Z})^m / p^m \mathbb{Z}=p^m \mathbb{Z} / p^m \mathbb{Z} \cong 0 .
$$
Thus $p \mathbb{Z} / p^m \mathbb{Z}$ is nilpotent in $\mathbb{Z} / p^m \mathbb{Z}$.
-/

theorem Dummit_Foote_exercise_7_3_37 {p m : ℕ} (_hp : p.Prime) :
  IsNilpotent (span ({↑p} : Set $ ZMod $ p^m) : Ideal $ ZMod $ p^m) := by
  -- Step 1: Introduce the ideal generated by the image of `p` in `ZMod (p^m)` to simplify notation.
  set I : Ideal (ZMod (p^m)) :=
    (span ({(↑p : ZMod (p^m))} : Set (ZMod (p^m)))) with hI
  -- Step 1.1: With this notation in place, supply the nilpotency witness that we will verify.
  refine ⟨Nat.succ m, ?_⟩
  -- Step 2: Rewrite the `Nat.succ m`-th power of the principal ideal using the general power formula.
  have hpow :
      I ^ Nat.succ m =
        span ({((p : ZMod (p^m)) ^ Nat.succ m)} : Set (ZMod (p^m))) := by
    -- Step 2.1: Apply `Ideal.span_singleton_pow` to convert the ideal power into a span of a single element.
    simpa [I] using
      (Ideal.span_singleton_pow (s := (p : ZMod (p^m))) (n := Nat.succ m))
  -- Step 3: Prove that the generator `((p : ZMod (p^m)) ^ Nat.succ m)` is actually zero in the ring.
  have hpPowZero :
      ((p : ZMod (p^m)) ^ Nat.succ m) = 0 := by
    -- Step 3.1: Show that `p ^ m` divides `p ^ (m + 1)` inside the natural numbers.
    have hDiv : p ^ m ∣ p ^ Nat.succ m := by
      -- Step 3.1.1: Use the explicit witness `p`, together with the standard power formula.
      refine ⟨p, ?_⟩
      -- Step 3.1.1.1: Simplify the right-hand side with the recursive definition of powers.
      simp [Nat.pow_succ]
    -- Step 3.2: Translate the divisibility statement into the vanishing of the corresponding element of `ZMod`.
    have hCast :
        ((p ^ Nat.succ m : ℕ) : ZMod (p^m)) = 0 := by
      -- Step 3.2.1: Invoke the `ZMod` criterion: a natural number maps to zero iff it is divisible by the modulus.
      exact (ZMod.natCast_eq_zero_iff (a := p ^ Nat.succ m) (b := p ^ m)).2 hDiv
    -- Step 3.3: Re-express the element as a power of the class of `p` and obtain the desired vanishing.
    simpa [Nat.cast_pow] using hCast
  -- Step 4: Conclude that the specified power of `I` is the zero ideal, hence nilpotent.
  simp [hpow, hpPowZero]
