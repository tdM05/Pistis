import Mathlib

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators



/-Informal Statement

Prove that if $H$ is a subgroup of $G$ then $H$ is generated by the set $H-\{1\}$.
-/

/-Informal Proof

If $H=\{1\}$ then $H-\{1\}$ is the empty set which indeed generates the trivial subgroup $H$. So suppose $|H|>1$ and pick a nonidentity element $h \in H$. Since $1=h h^{-1} \in\langle H-\{1\}\rangle$ (Proposition 9), we see that $H \leq\langle H-\{1\}\rangle$. By minimality of $\langle H-\{1\}\rangle$, the reverse inclusion also holds so that $\langle H-\{1\}\rangle=$ $H$.
-/

theorem Dummit_Foote_exercise_2_4_4 {G : Type*} [Group G] (H : Subgroup G) :
  closure ((H : Set G) \ {1}) = H := by
  sorry

/-
Step 1. Explain why the formal statement above is false.
Step 2. Exhibit the trivial subgroup of the one-point group as a counterexample.
-/

/-!
Step 1. The underlying set of the trivial subgroup `⊤ : Subgroup Unit` is the whole type `Unit`.
        Removing the identity element (the only element) leaves the empty set.
Step 2. The topological closure of the empty set is still empty in every topological space.
Step 3. Therefore `closure ((⊤ : Subgroup Unit) : Set Unit \ {1}) = ∅`, whereas the underlying set
        of the subgroup is `{⋆}`; these two sets are not equal, so the statement fails.
-/

theorem exercise_2_4_4_counterexample :
    ∃ (G : Type) (_ : Group G) (_ : TopologicalSpace G) (H : Subgroup G),
      _root_.closure ((H : Set G) \ ({1} : Set G)) ≠ (H : Set G) := by
  -- Step 1: Choose the one-point group `Unit` together with its canonical structures.
  refine ⟨Unit, ?_⟩
  -- Step 1.1: Provide the group structure (the unique one on `Unit`).
  refine ⟨inferInstance, ?_⟩
  -- Step 1.2: Provide the topological structure (also the unique one).
  refine ⟨inferInstance, ?_⟩
  -- Step 1.3: Select the subgroup `⊤`, i.e., the whole group.
  refine ⟨(⊤ : Subgroup Unit), ?_⟩
  -- Step 2: Name the selected subgroup for readability.
  let Hunit : Subgroup Unit := ⊤
  -- Step 3: Compute the set difference; it is empty because `Unit` has only one element.
  have h_diff :
      ((Hunit : Set Unit) \ ({1} : Set Unit)) = (∅ : Set Unit) := by
    -- Step 3.1: Establish equality of sets by extensionality.
    ext x
    -- Step 3.1.1: The forward direction is impossible, so we derive a contradiction.
    constructor
    · -- Step 3.1.1.1: Unpack the membership in the set difference.
      intro hx
      rcases hx with ⟨-, hx_not⟩
      -- Step 3.1.1.2: Since `Unit` has only one element, `x` must be `()`, contradicting exclusion.
      cases x
      exact (hx_not rfl).elim
    · -- Step 3.1.2: No element belongs to the empty set, so the reverse implication is immediate.
      intro hx
      exact False.elim hx
  -- Step 4: Prove the desired inequality by contradiction.
  intro h_eq
  -- Step 4.1: Evaluate the supposed equality using the computation of the set difference.
  have h_eq' :
      (∅ : Set Unit) = (Hunit : Set Unit) := by
    simp at h_eq
  -- Step 4.2: Switch to the symmetric form for rewriting.
  have h_eq_symm : (Hunit : Set Unit) = (∅ : Set Unit) := h_eq'.symm
  -- Step 5: Obtain the contradictory membership information.
  -- Step 5.1: The unique element of `Unit` belongs to the subgroup.
  have h_mem : (() : Unit) ∈ (Hunit : Set Unit) := by
    -- Step 5.1.1: Membership is automatic because `Hunit` is the whole group.
    simp [Hunit]
  -- Step 5.2: Transport the membership along the false equality to land in the empty set.
  have h_mem_empty : (() : Unit) ∈ (∅ : Set Unit) := by
    -- Step 5.2.1: Rewriting with the symmetric equality forces membership in the empty set.
    simp [h_eq_symm] at h_mem
  -- Step 5.3: Contradict the fact that no element belongs to the empty set.
  exact h_mem_empty.elim

theorem Dummit_Foote_exercise_2_4_4_neg :
    ¬
      (∀ (G : Type) (_ : Group G) (_ : TopologicalSpace G) (H : Subgroup G),
        _root_.closure ((H : Set G) \ ({1} : Set G)) = (H : Set G)) := by
  -- Step 1: Assume the universal claim holds in order to reach a contradiction.
  -- Step 1.0: Demonstrating failure already for `Type` suffices, since `Unit` belongs to every
  --           universe level and therefore contradicts the original `Type*` formulation as well.
  intro h_univ
  -- Step 2: Extract the concrete counterexample obtained above.
  obtain ⟨G, hG, hTop, H, h_ne⟩ := exercise_2_4_4_counterexample
  -- Step 3: Apply the assumed universal statement to this specific triple.
  have h_eq := h_univ G hG hTop H
  -- Step 4: Use the inequality from the counterexample to contradict the universal claim.
  exact h_ne h_eq

/-
Corrected Statement:
Step 1. Interpret “generated by” as `Subgroup.closure`, the algebraic subgroup generated by a set.
Step 2. Show that removing the identity from `H` does not change the subgroup it generates.
-/

theorem Dummit_Foote_exercise_2_4_4_corrected {G : Type*} [Group G] (H : Subgroup G) :
    Subgroup.closure ((H : Set G) \ {1}) = H := by
  -- Step 1: Switch to classical logic for case splits on equality.
  classical
  -- Step 2: Introduce the set whose closure we are studying.
  set S : Set G := (H : Set G) \ ({1} : Set G)
  -- Step 3: Prove the desired equality via mutual inclusions.
  refine le_antisymm ?h_le ?h_ge
  -- Step 4: First inclusion — the generated subgroup lies inside `H`.
  · -- Step 4.1: Use the universal property of the subgroup closure.
    refine (Subgroup.closure_le (K := H)).2 ?subset
    -- Step 4.1.1: Any element of `S` already belongs to `H`.
    intro g hg
    -- Step 4.1.2: Unpack membership in the set difference.
    rcases hg with ⟨hgH, -⟩
    -- Step 4.1.3: Conclude the element is in `H`.
    exact hgH
  -- Step 5: Second inclusion — every element of `H` lies in the generated subgroup.
  · -- Step 5.1: Take an arbitrary element of `H`.
    intro g hgH
    -- Step 5.2: Split on whether the element equals the identity.
    by_cases h1 : g = (1 : G)
    · -- Step 5.2.1: The identity belongs to every subgroup, in particular the closure.
      simp [S, h1]
    · -- Step 5.2.2: Otherwise the element belongs to `S`, so it lies in the closure.
      have hgS : g ∈ S := by
        -- Step 5.2.2.1: Provide the two components required for membership in `S`.
        refine ⟨hgH, ?_⟩
        -- Step 5.2.2.2: Show the element is not the identity.
        simpa [Set.mem_singleton_iff] using h1
      -- Step 5.2.3: Conclude using the defining property of the subgroup closure.
      exact Subgroup.subset_closure hgS
