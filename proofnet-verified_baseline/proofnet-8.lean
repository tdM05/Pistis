import Mathlib

open Function Fintype Subgroup Ideal Polynomial Submodule Zsqrtd
open scoped BigOperators



/-Informal Statement

Prove that in the ring $\mathbb{Z}[x],(2) \cap(x)=(2 x)$.
-/

/-Informal Proof

Let $f(x) \in(2 x)$. Then there exists some polynomial $g(x) \in \mathbb{Z}$ such that
$$
f(x)=2 x g(x)
$$
But this means that $f(x) \in(2)$ (because $x g(x)$ is a polynomial), and $f(x) \in$ $(x)$ (because $2 g(x)$ is a polynomial). Thus, $f(x) \in(2) \cap(x)$, and
$$
(2 x) \subseteq(2) \cap(x)
$$
On the other hand, let $p(x) \in(2) \cap(x)$. Since $p(x) \in(2)$, there exists some polynomial $h(x) \in \mathbb{Z}[x]$ such that
$$
p(x)=2 h(x)
$$
Furthermore, $p(x) \in(x)$, so
$$
p(x)=x h_2(x)
$$
So, $2 h(x)=x h_2(x)$, for some $h_2(x) \in \mathbb{Z}[x]$. This means that $h(0)=0$, so $x$ divides $h(x)$; that is,
$$
h(x)=x q(x)
$$
for some $q(x) \in \mathbb{Z}[x]$, and
$$
p(x)=2 x q(x)
$$
Thus, $p(x) \in(2 x)$, and
$$
\text { (2) } \cap(x) \subseteq(2 x)
$$
Finally,
(2) $\cap(x)=(2 x)$,
as required.
-/

theorem Artin_exercise_10_2_4 :
  span ({2} : Set $ Polynomial ℤ) ⊓ (span {X}) =
  span ({2 * X} : Set $ Polynomial ℤ) := by
  classical
  -- Step 1: Prove that every polynomial in the intersection lies in the ideal generated by `2 * X`.
  refine le_antisymm ?_ ?_
  · -- Step 1.1: Start with a polynomial that belongs to the intersection.
    intro p hp
    -- Step 1.2: Unpack the membership information from the intersection.
    rcases Ideal.mem_inf.mp hp with ⟨hp2, hpX⟩
    -- Step 1.3: Express `p` as a multiple of `2` and as a multiple of `X`.
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hp2
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hpX
    -- Step 1.4: Combine the two representations to relate the auxiliary polynomials `a` and `b`.
    have hEq : (2 : Polynomial ℤ) * a = X * b := by
      simpa [ha] using hb
    -- Step 1.5: Compare the coefficients of degree zero to show that the constant term of `a` vanishes.
    have hcoeffEq : (2 : ℤ) * a.coeff 0 = 0 := by
      simpa using congrArg (fun q : Polynomial ℤ => q.coeff 0) hEq
    have hcoeffZero : a.coeff 0 = 0 := by
      have htwo : (2 : ℤ) ≠ 0 := by decide
      exact (mul_eq_zero.mp hcoeffEq).resolve_left htwo
    -- Step 1.6: Convert the vanishing constant term into the divisibility statement `X ∣ a`.
    have hXdvd : X ∣ a := Polynomial.X_dvd_iff.mpr hcoeffZero
    rcases hXdvd with ⟨c, hc⟩
    -- Step 1.7: Re-express `p` using the witness `c` so that `2 * X` appears as a factor.
    have hp' : p = (2 * X) * c := by
      -- Step 1.7.1: Chain the equalities displaying the shared factor `2 * X`.
      calc
        p = (2 : Polynomial ℤ) * a := ha
        _ = (2 : Polynomial ℤ) * (X * c) := by
          simp [hc]
        _ = ((2 : Polynomial ℤ) * X) * c := by
          simp [mul_assoc]
    -- Step 1.8: Finish the inclusion by showing the divisibility by `2 * X`.
    refine Ideal.mem_span_singleton.mpr ?_
    refine ⟨c, hp'⟩
  · -- Step 2: Show that the ideal generated by `2 * X` is contained in the intersection.
    refine le_inf ?_ ?_
    · -- Step 2.1: Check that `2 * X` belongs to the ideal generated by `2`.
      refine Ideal.span_le.mpr ?_
      intro q hq
      rcases Set.mem_singleton_iff.mp hq with rfl
      -- Step 2.1.1: Exhibit the required multiple explicitly.
      refine Ideal.mem_span_singleton.mpr ?_
      refine ⟨X, ?_⟩
      simp
    · -- Step 2.2: Check that `2 * X` belongs to the ideal generated by `X`.
      refine Ideal.span_le.mpr ?_
      intro q hq
      rcases Set.mem_singleton_iff.mp hq with rfl
      -- Step 2.2.1: Exhibit the required multiple explicitly.
      refine Ideal.mem_span_singleton.mpr ?_
      refine ⟨(2 : Polynomial ℤ), ?_⟩
      simp [mul_comm]
