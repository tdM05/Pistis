import Mathlib

open Function Fintype Subgroup Ideal Polynomial Submodule Zsqrtd
open scoped BigOperators



/-Informal Statement

Let $H$ be the subgroup generated by two elements $a, b$ of a group $G$. Prove that if $a b=b a$, then $H$ is an abelian group.
-/

/-Informal Proof

Since $a$ and $b$ commute, for any $g, h\in H$ we can write $g=a^ib^j$ and $h = a^kb^l$. Then $gh = a^ib^ja^kb^l = a^kb^la^ib^j = hg$. Thus $H$ is abelian.
-/

theorem Artin_exercise_2_2_9 {G : Type*} [Group G] {a b : G}
  (h : a * b = b * a) :
  ∀ x y : closure {x | x = a ∨ x = b}, x * y = y * x := by
  -- Step 1: Work in a classical context so that upcoming case splits are available.
  classical
  -- Step 2: Introduce arbitrary subgroup elements `x` and `y` that we must show commute.
  intro x y
  -- Step 3: Fix the generating set `S` for cleaner notation.
  let S : Set G := {g : G | g = a ∨ g = b}
  -- Step 4: Record that the underlying element of `x` lies in the closure of `S`.
  have hx : (x : G) ∈ closure S := by
    -- Step 4.1: `x` is a subtype coerced from the closure, so the property follows by definition.
    simp [S, x.property]
  have hy : (y : G) ∈ closure S := by
    -- Step 4.2: The same reasoning applies to `y`.
    simp [S, y.property]
  -- Step 5: Establish that the underlying elements commute inside `G` via closure induction.
  have hcomm : (x : G) * (y : G) = (y : G) * (x : G) := by
    -- Step 5.1: Invoke the two-variable closure induction tailored to multiplicative subgroups.
    refine Subgroup.closure_induction₂
      (k := S)
      (p := fun u v _ _ => u * v = v * u)
      ?mem_case
      ?one_left_case
      ?one_right_case
      ?mul_left_case
      ?mul_right_case
      ?inv_left_case
      ?inv_right_case
      hx
      hy
    -- Step 5.1.1: Handle the base cases where both elements are generators (`a` or `b`).
    · intro u v hu hv
      -- Step 5.1.1.1: Unpack the disjunction describing each generator.
      rcases hu with rfl | rfl
      · rcases hv with rfl | rfl
        · -- Step 5.1.1.2: Both elements equal `a`, so commutativity is immediate.
          simp
        · -- Step 5.1.1.3: The elements `a` and `b` commute by the hypothesis `h`.
          simpa using h
      · rcases hv with rfl | rfl
        · -- Step 5.1.1.4: `b` and `a` commute because `h` is symmetric.
          simpa using h.symm
        · -- Step 5.1.1.5: Both elements equal `b`, so commutativity is trivial.
          simp
    -- Step 5.1.2: Show the property holds when the left argument is `1`.
    · intro u hu
      -- Step 5.1.2.1: The identity commutes with everything in a group.
      simp
    -- Step 5.1.3: Show the property holds when the right argument is `1`.
    · intro u hu
      -- Step 5.1.3.1: Again, the identity commutes universally.
      simp
    -- Step 5.1.4: Verify that the property is stable under multiplication on the left.
    · intro u v w hu hv hw huv hvw
      -- Step 5.1.4.1: Reinterpret the hypotheses via the `Commute` predicate.
      have huv_comm : Commute u w := huv
      have hvw_comm : Commute v w := hvw
      -- Step 5.1.4.2: Use `Commute.mul_left` to combine the two commutation relations.
      exact (huv_comm.mul_left hvw_comm).eq
    -- Step 5.1.5: Verify stability under multiplication on the right.
    · intro v w u hv hw hu huv huw
      -- Step 5.1.5.1: Translate the hypotheses into `Commute` statements.
      have huv_comm : Commute u v := huv
      have huw_comm : Commute u w := huw
      -- Step 5.1.5.2: Apply `Commute.mul_right` to combine the relations.
      exact (huv_comm.mul_right huw_comm).eq
    -- Step 5.1.6: Show that taking inverses on the left preserves commutativity.
    · intro u v hu hv huv
      -- Step 5.1.6.1: Promote the hypothesis to a commuting pair.
      have huv_comm : Commute u v := huv
      -- Step 5.1.6.2: Use `Commute.inv_left` for inverse stability on the left.
      exact (huv_comm.inv_left).eq
    -- Step 5.1.7: Show that taking inverses on the right also preserves commutativity.
    · intro u v hu hv huv
      -- Step 5.1.7.1: Again, reinterpret the hypothesis as a commuting pair.
      have huv_comm : Commute u v := huv
      -- Step 5.1.7.2: Apply `Commute.inv_right` for inverse stability on the right.
      exact (huv_comm.inv_right).eq
  -- Step 6: Transport the established equality in `G` back to the subgroup (`closure S`).
  apply Subtype.coe_injective
  -- Step 6.1: Rephrase the goal using coercions to compare elements in `G`.
  change (x : G) * (y : G) = (y : G) * (x : G)
  -- Step 6.2: Finish using the equality obtained earlier.
  exact hcomm
