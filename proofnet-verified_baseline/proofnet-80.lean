import Mathlib

open Fintype Set Real Ideal Polynomial
open scoped BigOperators



/-Informal Statement

Prove that any two nonabelian groups of order 21 are isomorphic.
-/

/-Informal Proof

By Cauchy's theorem we have that if $G$ is a group of order 21 then it has an element $a$ of order 3 and an element $b$ of order 7. By exercise 2.5.41 we have that the subgroup generated by $b$ is normal, so there is some $i=0,1,2,3,4,5,6$ such that $a b a^{-1}=b^i$. We know $i \neq$ 0 since that implies $a b=a$ and so that $b=e$, a contradiction, and we know $i \neq 1$ since then $a b=b a$ and this would imply $G$ is abelian, which we are assuming is not the case.
Now, $a$ has order 3 so we must have $b=a^3 b a^{-3}=b^{i^3}$ mod 7 , and so $i$ is restricted by the modular equation $i^3 \equiv 1 \bmod 7$
\begin{center}
\begin{tabular}{|c|c|}
\hline$x$ & $x^3 \bmod 7$ \\
\hline 2 & 1 \\
\hline 3 & 6 \\
\hline 4 & 1 \\
\hline 5 & 6 \\
\hline 6 & 6 \\
\hline
\end{tabular}
\end{center}
Therefore the only options are $i=2$ and $i=4$. Now suppose $G$ is such that $a b a^{-1}=b^2$ and let $G^{\prime}$ be another group of order 21 with an element $c$ of order 3 and an element $d$ of order 7 such that $c d c^{-1}=d^4$. We now prove that $G$ and $G^{\prime}$ are isomorphic. Define
$$
\begin{aligned}
\phi: G & \rightarrow G^{\prime} \\
a & \mapsto c^{-1} \\
b & \mapsto d
\end{aligned}
$$
since $a$ and $c^{-1}$ have the same order and $b$ and $d$ have the same order this is a well defined function. Since
$$
\begin{aligned}
\phi(a) \phi(b) \phi(a)^{-1} & =c^{-1} d c \\
& =\left(c d^{-1} c^{-1}\right)^{-1} \\
& =\left(d^{-4}\right)^{-1} \\
& =d^4 \\
& =\left(d^2\right)^2 \\
& =\phi(b)^2
\end{aligned}
$$
$\phi$ is actually a homomorphism. For any $c^i d^j \in G^{\prime}$ we have $\phi\left(a^{-i} b^j\right)=c^i d^j$ so $\phi$ is onto and $\phi\left(a^i b^j\right)=c^{-i} d^j=e$ only if $i=j=0$, so $\phi$ is 1-to-l. Therefore $G$ and $G^{\prime}$ are isomorphic and so up to isomorphism there is only one nonabelian group of order 21 .
-/

theorem Herstein_exercise_2_8_12 {G H : Type*} [Fintype G] [Fintype H]
  [Group G] [Group H] (hG : card G = 21) (_hH : card H = 21)
  (hG1 : IsEmpty (CommGroup G)) (_hH1 : IsEmpty (CommGroup H)) :
  Nonempty (G ≃* H) := by
  /-
  Step 1: We work in a classical setting so that we can freely use
  noncomputable constructions such as `Fintype.equivOfCardEq`.
  -/
  classical

  /-
  Step 2: For the type `G`, we show that there exists *some*
  commutative group structure on the same underlying type.

  Step 2.1: Since `Fintype.card G = 21` and `Fintype.card (Fin 21) = 21`,
  the types `G` and `Fin 21` have the same finite cardinality.
  Therefore there is an equivalence between `G` and `Fin 21`,
  and hence also between `G` and `Multiplicative (Fin 21)` (a type
  synonym which carries a commutative group structure coming from
  the additive group on `Fin 21`).
  -/
  have hG_card_MulFin :
      Fintype.card G = Fintype.card (Multiplicative (Fin 21)) := by
    -- Step 2.1.1: Record that `Fintype.card (Fin 21) = 21`.
    have hFin : Fintype.card (Fin 21) = 21 := by
      -- This is the standard cardinality of `Fin 21`.
      simp
    /-
    Step 2.1.2: The type synonyms `Fin 21` and `Multiplicative (Fin 21)`
    have the same cardinality, so `Fintype.card (Multiplicative (Fin 21)) = 21`
    as well.  Then transitivity of equality gives the desired equality
    `Fintype.card G = Fintype.card (Multiplicative (Fin 21))`.
    -/
    have hMulFin : Fintype.card (Multiplicative (Fin 21)) = 21 := by
      -- This `simpa` works because `Multiplicative` is a type synonym.
      simp
    -- Now use transitivity: `card G = 21 = card (Multiplicative (Fin 21))`.
    exact hG.trans hMulFin.symm

  /-
  Step 2.2: From the equality of cardinals we obtain an explicit
  equivalence `eG : G ≃ Multiplicative (Fin 21)`.
  -/
  let eG : G ≃ Multiplicative (Fin 21) :=
    Fintype.equivOfCardEq hG_card_MulFin

  /-
  Step 2.3: The type `Fin 21` has an additive commutative group
  structure, so `Multiplicative (Fin 21)` has a commutative group
  structure (by transferring the additive one to a multiplicative one).
  Using the equivalence `eG`, we transport this commutative group
  structure back to `G`, obtaining a term of type `CommGroup G`.
  -/
  have hG_commGroup : Nonempty (CommGroup G) := by
    -- Step 2.3.1: Build the commutative group structure on `G`
    -- by transporting along `eG`.
    let inst : CommGroup G := eG.commGroup
    -- Step 2.3.2: Package this structure as a `Nonempty` witness.
    exact ⟨inst⟩

  /-
  Step 3: Derive a contradiction from `hG1 : IsEmpty (CommGroup G)`
  and the existence of a commutative group structure just constructed.

  Step 3.1: Unpack the witness from `hG_commGroup` and feed it to
  the eliminator of `IsEmpty (CommGroup G)` to obtain `False`.
  -/
  have hFalse : False := by
    -- Step 3.1.1: Extract an explicit commutative group structure on `G`.
    cases hG_commGroup with
    | intro instCommGroupG =>
      -- Step 3.1.2: Apply the `IsEmpty` eliminator to this element,
      -- yielding a contradiction.
      exact hG1.false instCommGroupG

  /-
  Step 4: Conclude the goal.

  Since `False` implies *any* proposition, we can conclude that
  there exists a group isomorphism `G ≃* H`.  Note that the isomorphism
  is obtained purely by logical reasoning (ex falso), not by exhibiting
  a concrete map; this reflects the fact that the given hypotheses on
  `G` and `H` are inconsistent.
  -/
  exact False.elim hFalse

/-
Corrected version of the statement.

The original uses `IsEmpty (CommGroup G)` and `IsEmpty (CommGroup H)` for
"non-abelian". As in proofnet-77, these hypotheses are unsatisfiable when
`card G = card H = 21` (any 21-element type admits a `CommGroup` structure
transported from `Multiplicative (ZMod 21)`), so the original proof merely
derives `False`.

The corrected statement expresses non-abelian-ness via the existing
multiplication: `∃ a b, a * b ≠ b * a`.
-/

namespace Herstein_2_8_12

/-- For a finite group `K` of order 21 with element `b` of order 7, the cyclic
subgroup `⟨b⟩` is normal: it's the unique Sylow-7 subgroup. -/
private lemma normal_zpowers_of_order7 {K : Type*} [Group K] [Fintype K]
    (hK : Fintype.card K = 21) (b : K) (hb : orderOf b = 7) :
    (Subgroup.zpowers b).Normal := by
  classical
  haveI : Fact (Nat.Prime 7) := ⟨by decide⟩
  have hcardK : Nat.card K = 21 := by rw [Nat.card_eq_fintype_card]; exact hK
  -- Build Sylow-7 from ⟨b⟩
  have hpgroup : IsPGroup 7 (Subgroup.zpowers b) := by
    rw [IsPGroup.iff_card]
    refine ⟨1, ?_⟩
    rw [Nat.card_zpowers, hb, pow_one]
  have hbindex : (Subgroup.zpowers b).index = 3 := by
    have h := (Subgroup.zpowers b).card_mul_index
    rw [Nat.card_zpowers, hb, hcardK] at h; omega
  have hnotdvd : ¬ 7 ∣ (Subgroup.zpowers b).index := by rw [hbindex]; decide
  let P : Sylow 7 K := hpgroup.toSylow hnotdvd
  have hP_eq : (P : Subgroup K) = Subgroup.zpowers b := rfl
  -- Subsingleton: |Sylow 7 K| ≡ 1 mod 7 and divides 3
  haveI hSub : Subsingleton (Sylow 7 K) := by
    have hmod : Nat.card (Sylow 7 K) ≡ 1 [MOD 7] := card_sylow_modEq_one 7 K
    have hdvd : Nat.card (Sylow 7 K) ∣ 3 := by
      have h := P.card_dvd_index
      rw [show (P : Subgroup K) = Subgroup.zpowers b from rfl] at h
      rwa [hbindex] at h
    have hle : Nat.card (Sylow 7 K) ≤ 3 := Nat.le_of_dvd (by decide) hdvd
    have hcard1 : Nat.card (Sylow 7 K) = 1 := by
      interval_cases (Nat.card (Sylow 7 K)) <;> revert hmod <;> decide
    exact (Nat.card_eq_one_iff_unique.mp hcard1).1
  have := Sylow.normal_of_subsingleton P
  rwa [hP_eq] at this

/-- For non-abelian `K` of order 21, there exist `a, b ∈ K` with `orderOf a = 3`,
`orderOf b = 7`, and `a * b * a⁻¹ = b ^ 2`. -/
private lemma exists_canonical_generators_21 {K : Type*} [Group K] [Fintype K]
    (hK : Fintype.card K = 21) (hKnab : ∃ x y : K, x * y ≠ y * x) :
    ∃ a b : K, orderOf a = 3 ∧ orderOf b = 7 ∧ a * b * a⁻¹ = b ^ 2 := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fact (Nat.Prime 7) := ⟨by decide⟩
  -- Cauchy
  have h3dvd : (3 : ℕ) ∣ Fintype.card K := by rw [hK]; decide
  have h7dvd : (7 : ℕ) ∣ Fintype.card K := by rw [hK]; decide
  obtain ⟨a₀, ha₀⟩ := exists_prime_orderOf_dvd_card 3 h3dvd
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card 7 h7dvd
  -- ⟨b⟩ normal
  have hbN : (Subgroup.zpowers b).Normal := normal_zpowers_of_order7 hK b hb
  -- a₀ * b * a₀⁻¹ ∈ ⟨b⟩
  have hconjmem : a₀ * b * a₀⁻¹ ∈ Subgroup.zpowers b :=
    hbN.conj_mem b (Subgroup.mem_zpowers b) a₀
  -- write conjugate as b ^ k₀ with 0 ≤ k₀ < 7
  rw [Subgroup.mem_zpowers_iff] at hconjmem
  obtain ⟨n, hn⟩ := hconjmem
  set k₀ : ℕ := (n % 7).toNat with hk₀_def
  have h7pos : (0 : ℤ) < 7 := by decide
  have hk₀_nonneg : (0 : ℤ) ≤ n % 7 := Int.emod_nonneg n h7pos.ne'
  have hk₀_lt7 : n % 7 < 7 := Int.emod_lt_of_pos n h7pos
  have hk₀_lt : k₀ < 7 := by
    rw [hk₀_def]; omega
  have hborder7 : b ^ (7 : ℕ) = 1 := by rw [← hb, pow_orderOf_eq_one]
  -- relate b ^ n (zpow) to b ^ k₀ (npow)
  have hzn_eq_nk₀ : b ^ n = b ^ k₀ := by
    have h1 : b ^ n = b ^ (n % 7) := by
      conv_lhs => rw [← Int.emod_add_mul_ediv n 7]
      rw [zpow_add, zpow_mul, show (b : K) ^ (7 : ℤ) = 1 from by
        rw [show (7 : ℤ) = ((7 : ℕ) : ℤ) from rfl, zpow_natCast]; exact hborder7]
      rw [one_zpow, mul_one]
    rw [h1]
    rw [show (n % 7) = ((k₀ : ℤ)) from by rw [hk₀_def]; exact Int.toNat_of_nonneg hk₀_nonneg |>.symm]
    rw [zpow_natCast]
  have hk₀_eq : a₀ * b * a₀⁻¹ = b ^ k₀ := by rw [← hn, hzn_eq_nk₀]
  -- iterated conjugation: a₀ * b^m * a₀⁻¹ = (b^k₀)^m
  have hconj_pow : ∀ m : ℕ, a₀ * b ^ m * a₀⁻¹ = (b ^ k₀) ^ m := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      have step : a₀ * (b ^ m * b) * a₀⁻¹
                = (a₀ * b ^ m * a₀⁻¹) * (a₀ * b * a₀⁻¹) := by group
      rw [pow_succ, step, ih, hk₀_eq, ← pow_succ]
  -- a₀ ^ 3 = 1
  have ha₀3 : a₀ ^ (3 : ℕ) = 1 := by rw [← ha₀, pow_orderOf_eq_one]
  -- Triple-conjugate: a₀^3 * b * a₀^(-3) = b^(k₀^3)
  -- Specifically, b^(k₀^3) = b
  have hcube_pow : b ^ (k₀ ^ 3) = b := by
    -- iterate hconj_pow 3 times: a₀^3 b a₀^(-3) = b^(k₀^3)
    have step3 : a₀ ^ (3 : ℕ) * b * (a₀ ^ (3 : ℕ))⁻¹ = b ^ (k₀ ^ 3) := by
      -- Build up via two applications of hconj_pow
      have h1 : a₀ * b * a₀⁻¹ = b ^ k₀ := hk₀_eq
      have h2 : a₀ * (b ^ k₀) * a₀⁻¹ = b ^ (k₀ * k₀) := by
        rw [hconj_pow, ← pow_mul]
      have h3 : a₀ * (b ^ (k₀ * k₀)) * a₀⁻¹ = b ^ (k₀ * (k₀ * k₀)) := by
        rw [hconj_pow, ← pow_mul]
      -- a₀^3 b a₀^(-3) = a₀ * (a₀ * (a₀ * b * a₀⁻¹) * a₀⁻¹) * a₀⁻¹
      have heq : a₀ * (a₀ * (a₀ * b * a₀⁻¹) * a₀⁻¹) * a₀⁻¹
                = a₀ ^ (3 : ℕ) * b * (a₀ ^ (3 : ℕ))⁻¹ := by
        rw [pow_three']; group
      rw [show k₀ ^ 3 = k₀ * (k₀ * k₀) from by ring, ← h3, ← h2, ← h1, heq]
    rw [ha₀3, one_mul, inv_one, mul_one] at step3
    exact step3.symm
  -- Reduce: b^(k₀^3) = b^1 means k₀^3 % 7 = 1 % 7 = 1
  have hcube_mod : k₀ ^ 3 % 7 = 1 := by
    have h : b ^ (k₀ ^ 3) = b ^ 1 := by rw [pow_one]; exact hcube_pow
    rw [pow_inj_mod, hb] at h
    simpa using h
  -- k₀ ≠ 0 (else b = 1, contradicting orderOf b = 7)
  have hk₀_ne0 : k₀ ≠ 0 := by
    intro h0
    rw [h0, pow_zero] at hk₀_eq
    have hb1 : b = 1 := by
      have : b = a₀⁻¹ * (a₀ * b * a₀⁻¹) * a₀ := by group
      rw [this, hk₀_eq]; group
    rw [hb1, orderOf_one] at hb
    exact absurd hb (by decide)
  -- k₀ ≠ 1 (else a₀, b commute, K cyclic, K abelian, contradicting hKnab)
  have hk₀_ne1 : k₀ ≠ 1 := by
    intro h1
    rw [h1, pow_one] at hk₀_eq
    have hcomm : Commute a₀ b := by
      show a₀ * b = b * a₀
      have h : a₀ * b * a₀⁻¹ * a₀ = b * a₀ := by rw [hk₀_eq]
      simpa [mul_assoc] using h
    have hcoprime : (orderOf a₀).Coprime (orderOf b) := by rw [ha₀, hb]; decide
    have horder_ab : orderOf (a₀ * b) = 21 := by
      rw [hcomm.orderOf_mul_eq_mul_orderOf_of_coprime hcoprime, ha₀, hb]
    have hcyc : IsCyclic K := isCyclic_of_orderOf_eq_card (a₀ * b) (by
      rw [horder_ab, Nat.card_eq_fintype_card, hK])
    have hcommG := (IsCyclic.commutative (α := K)).comm
    obtain ⟨x, y, hxy⟩ := hKnab
    exact hxy (hcommG x y)
  -- k₀³ ≡ 1, k₀ < 7, k₀ ≠ 0, 1: so k₀ ∈ {2, 4}.
  have hk₀_24 : k₀ = 2 ∨ k₀ = 4 := by
    interval_cases k₀
    · exact absurd rfl hk₀_ne0
    · exact absurd rfl hk₀_ne1
    · left; rfl
    · revert hcube_mod; decide
    · right; rfl
    · revert hcube_mod; decide
    · revert hcube_mod; decide
  rcases hk₀_24 with h2 | h4
  · -- k₀ = 2: return (a₀, b)
    exact ⟨a₀, b, ha₀, hb, by rw [hk₀_eq, h2]⟩
  · -- k₀ = 4: return (a₀², b). Check (a₀²) * b * (a₀²)⁻¹ = b^(k₀²) = b^16 = b^2.
    refine ⟨a₀ ^ (2 : ℕ), b, ?_, hb, ?_⟩
    · -- orderOf (a₀²) = 3 since gcd(orderOf a₀, 2) = gcd(3, 2) = 1
      have hcoprime : (orderOf a₀).Coprime 2 := by rw [ha₀]; decide
      rw [hcoprime.orderOf_pow]; exact ha₀
    · -- Compute conjugation: (a₀²) * b * (a₀²)⁻¹ = b^(k₀²) = b^16 = b^2 (since k₀ = 4)
      have step1 : a₀ ^ (2 : ℕ) * b * (a₀ ^ (2 : ℕ))⁻¹
                  = a₀ * (a₀ * b * a₀⁻¹) * a₀⁻¹ := by
        rw [pow_two, mul_inv_rev]; group
      rw [step1, hk₀_eq, hconj_pow k₀, ← pow_mul, h4]
      -- goal: b ^ (4 * 4) = b ^ 2
      rw [show (4 * 4 : ℕ) = 2 + 7 * 2 from rfl, pow_add, pow_mul, hborder7,
        one_pow, mul_one]

end Herstein_2_8_12

namespace Herstein_2_8_12

/-- For canonical generators with `a * b * a⁻¹ = b ^ 2`, we have
`b ^ j * a = a * b ^ (4 * j)`. -/
private lemma comm_b_a_pow {K : Type*} [Group K]
    (a b : K) (hb : orderOf b = 7) (hrel : a * b * a⁻¹ = b ^ 2) :
    ∀ j : ℕ, b ^ j * a = a * b ^ (j * 4) := by
  -- a⁻¹ * b * a = b ^ 4: From hrel, b = a⁻¹ * b^2 * a (conjugating by a⁻¹).
  -- Iterating: b^4 = a⁻¹ * b^8 * a = a⁻¹ * b * a (since b^7 = 1).
  have hborder : b ^ (7 : ℕ) = 1 := by rw [← hb, pow_orderOf_eq_one]
  have hab : a * b = b ^ 2 * a := by
    have : a * b * a⁻¹ * a = b ^ 2 * a := by rw [hrel]
    simpa [mul_assoc] using this
  -- Iterating hab: a * b^j = b^(2*j) * a.
  have hab_pow : ∀ j : ℕ, a * b ^ j = b ^ (2 * j) * a := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [pow_succ, ← mul_assoc, ih, mul_assoc, hab, ← mul_assoc, ← pow_add,
        show 2 * j + 2 = 2 * (j + 1) from by ring]
  -- For 4 * j' where j' = j (mod 7): want to reverse — write b^j * a in terms of a.
  -- From hab_pow with j replaced by 4j: a * b^(4j) = b^(8j) * a = b^j * a (since b^7 = 1).
  intro j
  have h := hab_pow (j * 4)
  -- h : a * b^(j*4) = b^(2 * (j * 4)) * a = b^(8j) * a
  have : (2 * (j * 4) : ℕ) % 7 = j % 7 := by
    have : (2 * (j * 4) : ℕ) = 8 * j := by ring
    rw [this]
    have : (8 * j) % 7 = (1 * j) % 7 := by
      rw [show (8 : ℕ) = 1 + 7 from rfl, add_mul, one_mul, Nat.add_mul_mod_self_left]
    rw [this, one_mul]
  -- So b^(8j) = b^j (mod orderOf b)
  have h8j : b ^ (2 * (j * 4)) = b ^ j := by
    rw [show (2 * (j * 4) : ℕ) = j + 7 * j from by ring, pow_add, pow_mul, hborder, one_pow, mul_one]
  rw [h8j] at h
  exact h.symm

/-- Iterated form: `b ^ j * a ^ i = a ^ i * b ^ (j * 4 ^ i)`. -/
private lemma comm_b_a_pow_pow {K : Type*} [Group K]
    (a b : K) (hb : orderOf b = 7) (hrel : a * b * a⁻¹ = b ^ 2) :
    ∀ i j : ℕ, b ^ j * a ^ i = a ^ i * b ^ (j * 4 ^ i) := by
  intro i
  induction i with
  | zero => intro j; simp
  | succ i ih =>
    intro j
    rw [pow_succ, ← mul_assoc, ih, mul_assoc, comm_b_a_pow a b hb hrel,
      ← mul_assoc, ← pow_succ]
    congr 2; ring

/-- `(i, j) ↦ a^i * b^j` is bijective from `Fin 3 × Fin 7` to `K` of order 21. -/
private lemma exp_bijective {K : Type*} [Group K] [Fintype K]
    (hK : Fintype.card K = 21) (a b : K) (ha : orderOf a = 3) (hb : orderOf b = 7) :
    Function.Bijective (fun p : Fin 3 × Fin 7 => a ^ p.1.val * b ^ p.2.val) := by
  classical
  have hcardprod : Fintype.card (Fin 3 × Fin 7) = 21 := by decide
  -- Disjoint subgroups
  have hdisj : Disjoint (Subgroup.zpowers a) (Subgroup.zpowers b) := by
    rw [Subgroup.disjoint_def]
    intro z hza hzb
    have hzord3 : orderOf z ∣ 3 := by rw [← ha]; exact orderOf_dvd_of_mem_zpowers hza
    have hzord7 : orderOf z ∣ 7 := by rw [← hb]; exact orderOf_dvd_of_mem_zpowers hzb
    have : orderOf z = 1 := by
      have := Nat.dvd_gcd hzord3 hzord7; simpa using this
    exact orderOf_eq_one_iff.mp this
  rw [Fintype.bijective_iff_injective_and_card]
  refine ⟨?_, by rw [hK, hcardprod]⟩
  rintro ⟨⟨i, hi⟩, ⟨j, hj⟩⟩ ⟨⟨i', hi'⟩, ⟨j', hj'⟩⟩ heq
  simp only at heq  -- unfold the function application
  simp only [Fin.mk.injEq, Prod.mk.injEq]
  -- heq : a ^ i * b ^ j = a ^ i' * b ^ j'
  have hkey : (a ^ i')⁻¹ * a ^ i = b ^ j' * (b ^ j)⁻¹ := by
    have h2 : (a ^ i')⁻¹ * (a ^ i * b ^ j) = (a ^ i')⁻¹ * (a ^ i' * b ^ j') := by
      rw [heq]
    rw [show (a ^ i')⁻¹ * (a ^ i' * b ^ j') = b ^ j' from by group, ← mul_assoc] at h2
    have h3 : (a ^ i')⁻¹ * a ^ i * b ^ j * (b ^ j)⁻¹ = b ^ j' * (b ^ j)⁻¹ := by rw [h2]
    rw [show (a ^ i')⁻¹ * a ^ i * b ^ j * (b ^ j)⁻¹ = (a ^ i')⁻¹ * a ^ i from by group] at h3
    exact h3
  have h_in_a : (a ^ i')⁻¹ * a ^ i ∈ Subgroup.zpowers a := by
    apply Subgroup.mul_mem
    · exact Subgroup.inv_mem _ (pow_mem (Subgroup.mem_zpowers a) _)
    · exact pow_mem (Subgroup.mem_zpowers a) _
  have h_in_b : (a ^ i')⁻¹ * a ^ i ∈ Subgroup.zpowers b := by
    rw [hkey]
    apply Subgroup.mul_mem
    · exact pow_mem (Subgroup.mem_zpowers b) _
    · exact Subgroup.inv_mem _ (pow_mem (Subgroup.mem_zpowers b) _)
  have h1 : (a ^ i')⁻¹ * a ^ i = 1 := Subgroup.disjoint_def.mp hdisj h_in_a h_in_b
  -- Therefore a^i = a^i' and b^j = b^j'
  have ha_eq : a ^ i = a ^ i' := by
    have : a ^ i = a ^ i' * ((a ^ i')⁻¹ * a ^ i) := by group
    rw [this, h1, mul_one]
  have hb_eq : b ^ j = b ^ j' := by
    have hb1 : b ^ j' * (b ^ j)⁻¹ = 1 := hkey ▸ h1
    have : b ^ j' = 1 * b ^ j := by
      have : b ^ j' * (b ^ j)⁻¹ * b ^ j = 1 * b ^ j := by rw [hb1]
      simpa [mul_assoc] using this
    rw [one_mul] at this
    exact this.symm
  -- a^i = a^i' with i, i' < 3 = orderOf a means i = i'
  have hii : i = i' := by
    have : i % orderOf a = i' % orderOf a := pow_inj_mod.mp ha_eq
    rw [ha] at this
    rw [Nat.mod_eq_of_lt hi, Nat.mod_eq_of_lt hi'] at this
    exact this
  have hjj : j = j' := by
    have : j % orderOf b = j' % orderOf b := pow_inj_mod.mp hb_eq
    rw [hb] at this
    rw [Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt hj'] at this
    exact this
  exact ⟨hii, hjj⟩

end Herstein_2_8_12

theorem Herstein_exercise_2_8_12_corrected {G H : Type*} [Fintype G] [Fintype H]
    [Group G] [Group H] (hG : card G = 21) (hH : card H = 21)
    (hG1 : ∃ a b : G, a * b ≠ b * a) (hH1 : ∃ a b : H, a * b ≠ b * a) :
    Nonempty (G ≃* H) := by
  classical
  obtain ⟨aG, bG, hordaG, hordbG, hrelG⟩ :=
    Herstein_2_8_12.exists_canonical_generators_21 hG hG1
  obtain ⟨aH, bH, hordaH, hordbH, hrelH⟩ :=
    Herstein_2_8_12.exists_canonical_generators_21 hH hH1
  -- Bijections (i, j) ↦ a^i * b^j for both groups.
  let eG : Fin 3 × Fin 7 ≃ G :=
    Equiv.ofBijective _ (Herstein_2_8_12.exp_bijective hG aG bG hordaG hordbG)
  let eH : Fin 3 × Fin 7 ≃ H :=
    Equiv.ofBijective _ (Herstein_2_8_12.exp_bijective hH aH bH hordaH hordbH)
  -- Define φ : G → H via the parametrization, and verify it is a MulEquiv.
  -- The multiplication formula
  --     (a^i * b^j) * (a^i' * b^j') = a^(i+i') * b^(j * 4^i' + j')
  -- is the same in both G and H (using the relation `a * b * a⁻¹ = b ^ 2`),
  -- so the bijection `eH ∘ eG⁻¹` is a group isomorphism.
  refine ⟨MulEquiv.mk (eG.symm.trans eH) ?_⟩
  -- map_mul: every element of G is uniquely a^i * b^j, and the multiplication
  -- formula transfers to H by the identical conjugation relation.
  intro x y
  -- Surjective writing of x and y via eG.
  set p := eG.symm x
  set q := eG.symm y
  have hx : x = aG ^ p.1.val * bG ^ p.2.val := (eG.apply_symm_apply x).symm
  have hy : y = aG ^ q.1.val * bG ^ q.2.val := (eG.apply_symm_apply y).symm
  -- Compute x * y using the multiplication formula in G.
  have hxy : x * y = aG ^ (p.1.val + q.1.val) * bG ^ (p.2.val * 4 ^ q.1.val + q.2.val) := by
    rw [hx, hy]
    calc (aG ^ p.1.val * bG ^ p.2.val) * (aG ^ q.1.val * bG ^ q.2.val)
        = aG ^ p.1.val * (bG ^ p.2.val * aG ^ q.1.val) * bG ^ q.2.val := by group
      _ = aG ^ p.1.val * (aG ^ q.1.val * bG ^ (p.2.val * 4 ^ q.1.val)) * bG ^ q.2.val := by
          rw [Herstein_2_8_12.comm_b_a_pow_pow aG bG hordbG hrelG]
      _ = aG ^ (p.1.val + q.1.val) * bG ^ (p.2.val * 4 ^ q.1.val + q.2.val) := by
          rw [pow_add, pow_add]; group
  -- Define the corresponding "shadow" multiplication on Fin 3 × Fin 7.
  -- The same formula in H gives:
  have hxy_H :
      aH ^ (p.1.val + q.1.val) * bH ^ (p.2.val * 4 ^ q.1.val + q.2.val) =
      (aH ^ p.1.val * bH ^ p.2.val) * (aH ^ q.1.val * bH ^ q.2.val) := by
    calc aH ^ (p.1.val + q.1.val) * bH ^ (p.2.val * 4 ^ q.1.val + q.2.val)
        = aH ^ p.1.val * (aH ^ q.1.val * bH ^ (p.2.val * 4 ^ q.1.val)) * bH ^ q.2.val := by
          rw [pow_add, pow_add]; group
      _ = aH ^ p.1.val * (bH ^ p.2.val * aH ^ q.1.val) * bH ^ q.2.val := by
          rw [Herstein_2_8_12.comm_b_a_pow_pow aH bH hordbH hrelH]
      _ = (aH ^ p.1.val * bH ^ p.2.val) * (aH ^ q.1.val * bH ^ q.2.val) := by group
  -- Now derive the goal: eG.symm.trans eH (x * y) = eG.symm.trans eH x * eG.symm.trans eH y.
  show (eG.symm.trans eH) (x * y) = (eG.symm.trans eH) x * (eG.symm.trans eH) y
  -- The LHS equals eH (eG.symm (x*y)), and similarly for RHS. Both reduce to the
  -- formula above via the bijections.
  -- To compute eG.symm (x * y): we have x * y = expG (i+i' mod 3, j*4^i' + j' mod 7),
  -- and expG composed with that pair equals x*y. So eG.symm (x*y) = (the pair).
  -- But there's a subtlety: the pair has natural-number arguments, not Fin.
  -- Reduce mod the orders:
  set i₁ : ℕ := p.1.val with hi₁
  set j₁ : ℕ := p.2.val with hj₁
  set i₂ : ℕ := q.1.val with hi₂
  set j₂ : ℕ := q.2.val with hj₂
  -- Construct the Fin pair representing the product.
  let r : Fin 3 × Fin 7 :=
    (⟨(i₁ + i₂) % 3, Nat.mod_lt _ (by decide)⟩,
      ⟨(j₁ * 4 ^ i₂ + j₂) % 7, Nat.mod_lt _ (by decide)⟩)
  have hexp_r : aG ^ r.1.val * bG ^ r.2.val = x * y := by
    show aG ^ ((i₁ + i₂) % 3) * bG ^ ((j₁ * 4 ^ i₂ + j₂) % 7) = x * y
    have hb_mod : bG ^ ((j₁ * 4 ^ i₂ + j₂) % 7) = bG ^ (j₁ * 4 ^ i₂ + j₂) := by
      conv_rhs => rw [← Nat.div_add_mod (j₁ * 4 ^ i₂ + j₂) 7]
      rw [pow_add, pow_mul, show bG ^ 7 = 1 from by rw [← hordbG, pow_orderOf_eq_one],
        one_pow, one_mul]
    have ha_mod : aG ^ ((i₁ + i₂) % 3) = aG ^ (i₁ + i₂) := by
      conv_rhs => rw [← Nat.div_add_mod (i₁ + i₂) 3]
      rw [pow_add, pow_mul, show aG ^ 3 = 1 from by rw [← hordaG, pow_orderOf_eq_one],
        one_pow, one_mul]
    rw [ha_mod, hb_mod, ← hxy]
  have heG_symm_xy : eG.symm (x * y) = r := by
    apply eG.injective
    rw [eG.apply_symm_apply]
    exact hexp_r.symm
  -- Same for H: define r', the corresponding Fin pair in H.
  have hexp_r_H : aH ^ r.1.val * bH ^ r.2.val =
      (aH ^ i₁ * bH ^ j₁) * (aH ^ i₂ * bH ^ j₂) := by
    show aH ^ ((i₁ + i₂) % 3) * bH ^ ((j₁ * 4 ^ i₂ + j₂) % 7) =
      (aH ^ i₁ * bH ^ j₁) * (aH ^ i₂ * bH ^ j₂)
    have hb_mod : bH ^ ((j₁ * 4 ^ i₂ + j₂) % 7) = bH ^ (j₁ * 4 ^ i₂ + j₂) := by
      conv_rhs => rw [← Nat.div_add_mod (j₁ * 4 ^ i₂ + j₂) 7]
      rw [pow_add, pow_mul, show bH ^ 7 = 1 from by rw [← hordbH, pow_orderOf_eq_one],
        one_pow, one_mul]
    have ha_mod : aH ^ ((i₁ + i₂) % 3) = aH ^ (i₁ + i₂) := by
      conv_rhs => rw [← Nat.div_add_mod (i₁ + i₂) 3]
      rw [pow_add, pow_mul, show aH ^ 3 = 1 from by rw [← hordaH, pow_orderOf_eq_one],
        one_pow, one_mul]
    rw [ha_mod, hb_mod]
    exact hxy_H
  -- Compute LHS and RHS of map_mul.
  show eH (eG.symm (x * y)) = eH (eG.symm x) * eH (eG.symm y)
  rw [heG_symm_xy]
  show aH ^ r.1.val * bH ^ r.2.val =
    (aH ^ p.1.val * bH ^ p.2.val) * (aH ^ q.1.val * bH ^ q.2.val)
  exact hexp_r_H
